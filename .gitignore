# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local mailbox (MAIL_DIR, ADR-0014)
/.mail/

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# prisma generated client (created by `prisma generate` / postinstall)
/src/generated/

# typescript
*.tsbuildinfo
next-env.d.ts
