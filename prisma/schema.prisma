// BeautyFits Prisma schema.
//
// Models are added by their owning tasks (TASK-003 onward) following
// docs/database/database-design.md. Conventions (ADR-0003):
// - money columns are integer minor units (BigInt/Int), never Float/Decimal
// - ids are UUIDv7 generated by the client: @id @default(uuid(7)) @db.Uuid (ADR-0010)
// - timestamps are stored in UTC
// - tables use snake_case names via @@map / @map

generator client {
  previewFeatures = ["partialIndexes"]
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Shared kernel (DB design v1.2 "Reliability"; TASK-003)
// ---------------------------------------------------------------------------

enum IdempotencyStatus {
  IN_PROGRESS
  COMPLETED
  FAILED

  @@map("idempotency_status")
}

/// Stored result of a retry-sensitive operation (API §9). A repeated request
/// with the same scope + operation + key returns the stored result.
model IdempotencyKey {
  id                 String            @id @default(uuid(7)) @db.Uuid
  /// Who the key belongs to, e.g. "EMPLOYEE:<id>", "CUSTOMER:<id>", "GUEST_CART:<token>".
  scope              String
  /// Operation name, e.g. "WALLET_ADJUSTMENT", "RETURN_COMPLETE", "WEBHOOK:<provider>".
  operation          String
  key                String
  requestFingerprint String            @map("request_fingerprint")
  status             IdempotencyStatus @default(IN_PROGRESS)
  responseStatus     Int?              @map("response_status")
  responseBody       Json?             @map("response_body_json")
  resourceType       String?           @map("resource_type")
  resourceId         String?           @map("resource_id") @db.Uuid
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt          DateTime          @map("expires_at") @db.Timestamptz(3)

  @@unique([scope, operation, key])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

enum OutboxStatus {
  PENDING
  PROCESSING
  DONE
  FAILED

  @@map("outbox_status")
}

/// Event written in the same transaction as a business change and delivered
/// by a worker after commit (Architecture v1.2 additions).
model OutboxEvent {
  id            String       @id @default(uuid(7)) @db.Uuid
  eventType     String       @map("event_type")
  aggregateType String       @map("aggregate_type")
  aggregateId   String       @map("aggregate_id") @db.Uuid
  payload       Json         @map("payload_json")
  status        OutboxStatus @default(PENDING)
  attemptCount  Int          @default(0) @map("attempt_count")
  availableAt   DateTime     @default(now()) @map("available_at") @db.Timestamptz(3)
  lastError     String?      @map("last_error")
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  processedAt   DateTime?    @map("processed_at") @db.Timestamptz(3)

  @@index([status, availableAt])
  @@map("outbox_events")
}

// ---------------------------------------------------------------------------
// Identity & customer authentication (DB design v1.2 §3 + "v1.2 TASK-007
// Amendments"; TASK-007, ADR-0013)
// ---------------------------------------------------------------------------

enum AccountType {
  CUSTOMER
  EMPLOYEE

  @@map("account_type")
}

enum AccountStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  DEACTIVATED

  @@map("account_status")
}

enum Locale {
  ar
  en

  @@map("locale")
}

enum AuthDomain {
  CUSTOMER
  EMPLOYEE

  @@map("auth_domain")
}

enum SessionRevokeReason {
  LOGOUT
  LOGOUT_ALL
  PASSWORD_CHANGE
  PASSWORD_RESET
  DEACTIVATED
  REUSE_DETECTED

  @@map("session_revoke_reason")
}

/// Authentication identity (DB design §3.1). A normalized email is unique per
/// account type only once verified (Business Spec R15, TASK-007 owner decision):
/// unverified PENDING_VERIFICATION accounts never reserve an email.
model Account {
  id                String        @id @default(uuid(7)) @db.Uuid
  accountType       AccountType   @map("account_type")
  /// Trimmed and lowercased.
  email             String
  emailVerifiedAt   DateTime?     @map("email_verified_at") @db.Timestamptz(3)
  /// scrypt hash with its parameters (ADR-0013); never the password.
  passwordHash      String        @map("password_hash")
  passwordChangedAt DateTime      @default(now()) @map("password_changed_at") @db.Timestamptz(3)
  status            AccountStatus @default(PENDING_VERIFICATION)
  lastLoginAt       DateTime?     @map("last_login_at") @db.Timestamptz(3)
  deactivatedAt     DateTime?     @map("deactivated_at") @db.Timestamptz(3)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  customer       Customer?
  employee       Employee?
  sessions       AuthSession[]
  otpChallenges  OtpChallenge[]
  trustedDevices EmployeeTrustedDevice[]

  @@unique([accountType, email], map: "accounts_verified_email_key", where: raw("email_verified_at IS NOT NULL"))
  @@index([accountType, email])
  @@map("accounts")
}

/// Customer profile (DB design §3.2). The phone is an Egyptian mobile number in
/// E.164 (Business Spec R27), unique only once verified.
model Customer {
  id              String    @id @default(uuid(7)) @db.Uuid
  accountId       String?   @unique @map("account_id") @db.Uuid
  /// E.164, e.g. +201012345678.
  phone           String
  phoneVerifiedAt DateTime? @map("phone_verified_at") @db.Timestamptz(3)
  fullName        String    @map("full_name")
  preferredLocale Locale    @default(ar) @map("preferred_locale")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  account Account? @relation(fields: [accountId], references: [id])

  @@unique([phone], map: "customers_verified_phone_key", where: raw("phone_verified_at IS NOT NULL"))
  @@index([phone])
  @@map("customers")
}

/// One login on one device: a refresh-token family (ADR-0008, ADR-0013).
/// Revoking the session invalidates every token issued for it.
model AuthSession {
  id           String               @id @default(uuid(7)) @db.Uuid
  accountId    String               @map("account_id") @db.Uuid
  domain       AuthDomain
  createdAt    DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  lastUsedAt   DateTime             @default(now()) @map("last_used_at") @db.Timestamptz(3)
  /// Absolute end of the session (customers: 30 days after login, Q162).
  expiresAt    DateTime             @map("expires_at") @db.Timestamptz(3)
  revokedAt    DateTime?            @map("revoked_at") @db.Timestamptz(3)
  revokeReason SessionRevokeReason? @map("revoke_reason")
  ipAddress    String?              @map("ip_address")
  userAgent    String?              @map("user_agent")

  account Account            @relation(fields: [accountId], references: [id])
  tokens  AuthSessionToken[]

  @@index([accountId, revokedAt])
  @@map("auth_sessions")
}

/// One issued access/refresh token pair. Only SHA-256 hashes are stored.
/// A pair is superseded (`rotated_at`) when its refresh token is used;
/// presenting a superseded refresh token again is reuse (ADR-0013).
model AuthSessionToken {
  id               String    @id @default(uuid(7)) @db.Uuid
  sessionId        String    @map("session_id") @db.Uuid
  accessTokenHash  String    @unique @map("access_token_hash")
  refreshTokenHash String    @unique @map("refresh_token_hash")
  accessExpiresAt  DateTime  @map("access_expires_at") @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  rotatedAt        DateTime? @map("rotated_at") @db.Timestamptz(3)

  session AuthSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("auth_session_tokens")
}

/// Throttling counter shared by all app instances (ADR-0013). Keys are
/// namespaced, e.g. "login:account:<sha256(email)>", "login:ip:<ip>".
model RateLimitBucket {
  key             String    @id
  count           Int
  windowStartedAt DateTime  @map("window_started_at") @db.Timestamptz(3)
  blockedUntil    DateTime? @map("blocked_until") @db.Timestamptz(3)
  updatedAt       DateTime  @map("updated_at") @db.Timestamptz(3)

  @@index([updatedAt])
  @@map("rate_limit_buckets")
}

// ---------------------------------------------------------------------------
// One-time codes (DB design v1.2 "otp_challenges" + "TASK-008 Amendments";
// TASK-008, ADR-0014)
// ---------------------------------------------------------------------------

enum OtpPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  EMPLOYEE_LOGIN
  EMAIL_CHANGE
  PHONE_CHANGE
  PHONE_VERIFICATION
  GUEST_ORDER_CLAIM

  @@map("otp_purpose")
}

enum OtpChannel {
  EMAIL
  WHATSAPP

  @@map("otp_channel")
}

/// One issued one-time code. Only a hash of the code is stored. A challenge
/// is usable once, until `expires_at`, for at most `max_attempts` wrong
/// guesses; issuing a new code for the same purpose supersedes it.
model OtpChallenge {
  id             String     @id @default(uuid(7)) @db.Uuid
  accountId      String?    @map("account_id") @db.Uuid
  purpose        OtpPurpose
  channel        OtpChannel
  /// Normalized email (or phone for future channels).
  destination    String
  /// SHA-256 of "<id>:<code>".
  codeHash       String     @map("code_hash")
  attemptCount   Int        @default(0) @map("attempt_count")
  maxAttempts    Int        @map("max_attempts")
  expiresAt      DateTime   @map("expires_at") @db.Timestamptz(3)
  lastSentAt     DateTime   @map("last_sent_at") @db.Timestamptz(3)
  consumedAt     DateTime?  @map("consumed_at") @db.Timestamptz(3)
  supersededAt   DateTime?  @map("superseded_at") @db.Timestamptz(3)
  /// Single-use grant tied to the code. PASSWORD_RESET: the reset token issued
  /// when the code is verified. EMPLOYEE_LOGIN: the login ticket issued with
  /// the code after the password check (TASK-011).
  grantTokenHash String?    @unique @map("grant_token_hash")
  grantExpiresAt DateTime?  @map("grant_expires_at") @db.Timestamptz(3)
  grantUsedAt    DateTime?  @map("grant_used_at") @db.Timestamptz(3)
  ipAddress      String?    @map("ip_address")
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)

  account Account? @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([purpose, destination, createdAt])
  @@index([accountId])
  @@map("otp_challenges")
}

// ---------------------------------------------------------------------------
// Employees and employee authentication (DB design §4 + "v1.2 TASK-011
// Amendments"; TASK-011, ADR-0015). Roles and permissions: TASK-012.
// ---------------------------------------------------------------------------

enum EmployeeLevel {
  OWNER
  ADMIN
  MANAGER
  EMPLOYEE

  @@map("employee_level")
}

enum EmployeeStatus {
  ACTIVE
  DEACTIVATED

  @@map("employee_status")
}

/// Staff profile (DB design §4). Never hard-deleted once it has business
/// history; access is removed by deactivation (Q64, Q69).
model Employee {
  id                  String         @id @default(uuid(7)) @db.Uuid
  accountId           String         @unique @map("account_id") @db.Uuid
  displayName         String         @map("display_name")
  employeeLevel       EmployeeLevel  @map("employee_level")
  department          String?
  status              EmployeeStatus @default(ACTIVE)
  createdByEmployeeId String?        @map("created_by_employee_id") @db.Uuid
  deactivatedAt       DateTime?      @map("deactivated_at") @db.Timestamptz(3)
  createdAt           DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  account   Account    @relation(fields: [accountId], references: [id])
  createdBy Employee?  @relation("EmployeeCreatedBy", fields: [createdByEmployeeId], references: [id])
  created   Employee[] @relation("EmployeeCreatedBy")

  roles              EmployeeRole[]       @relation("EmployeeRoleHolder")
  rolesAssigned      EmployeeRole[]       @relation("EmployeeRoleAssigner")
  rolesCreated       Role[]               @relation("RoleCreatedBy")
  invitationsSent    EmployeeInvitation[] @relation("InvitationInvitedBy")
  invitationsRevoked EmployeeInvitation[] @relation("InvitationRevokedBy")
  invitation         EmployeeInvitation?  @relation("InvitationAcceptedAs")
  settingsUpdated    Setting[]            @relation("SettingUpdatedBy")
  approvalsRequested ApprovalRequest[]    @relation("ApprovalRequestedBy")
  approvalsResolved  ApprovalRequest[]    @relation("ApprovalResolvedBy")
  mediaUploaded      MediaAsset[]         @relation("MediaAssetCreatedBy")

  @@index([status, employeeLevel])
  @@map("employees")
}

/// A device on which an employee completed the login email code (Business
/// Spec R28). Logins on it skip the code until `expires_at` (30 days after
/// the code). Only a SHA-256 hash of the device token is stored.
model EmployeeTrustedDevice {
  id              String    @id @default(uuid(7)) @db.Uuid
  accountId       String    @map("account_id") @db.Uuid
  deviceTokenHash String    @unique @map("device_token_hash")
  verifiedAt      DateTime  @map("verified_at") @db.Timestamptz(3)
  expiresAt       DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt       DateTime? @map("revoked_at") @db.Timestamptz(3)
  ipAddress       String?   @map("ip_address")
  userAgent       String?   @map("user_agent")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  account Account @relation(fields: [accountId], references: [id])

  @@index([accountId])
  @@map("employee_trusted_devices")
}

// ---------------------------------------------------------------------------
// Roles, permissions and invitations (TASK-012, DB design §4, ADR-0016)

/// A named set of permissions (Q66, Q67). Custom roles are created and edited
/// by Owner/Admin (User Flows §17.1); system roles are fixed and not
/// assignable through the API. Roles are never deleted.
model Role {
  id                  String   @id @default(uuid(7)) @db.Uuid
  /// Trimmed; unique ignoring case (checked by the service under a lock).
  name                String   @unique
  description         String?
  isSystemRole        Boolean  @default(false) @map("is_system_role")
  createdByEmployeeId String?  @map("created_by_employee_id") @db.Uuid
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  createdBy   Employee?        @relation("RoleCreatedBy", fields: [createdByEmployeeId], references: [id])
  permissions RolePermission[]
  employees   EmployeeRole[]

  @@map("roles")
}

/// The permission catalog (docs/security/permission-catalog.md). Rows are
/// inserted by migrations; the code list in src/server/modules/rbac/catalog.ts
/// must match them.
model Permission {
  id          String @id @default(uuid(7)) @db.Uuid
  code        String @unique
  description String

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model EmployeeRole {
  employeeId           String   @map("employee_id") @db.Uuid
  roleId               String   @map("role_id") @db.Uuid
  assignedByEmployeeId String?  @map("assigned_by_employee_id") @db.Uuid
  assignedAt           DateTime @default(now()) @map("assigned_at") @db.Timestamptz(3)

  employee   Employee  @relation("EmployeeRoleHolder", fields: [employeeId], references: [id])
  role       Role      @relation(fields: [roleId], references: [id])
  assignedBy Employee? @relation("EmployeeRoleAssigner", fields: [assignedByEmployeeId], references: [id])

  @@id([employeeId, roleId])
  @@index([roleId])
  @@map("employee_roles")
}

/// An invitation to join the staff by work email (Q64). Only a SHA-256 hash
/// of the invitation token is stored. Accepting it creates the employee
/// account with the level and roles chosen by the inviter.
model EmployeeInvitation {
  id                  String        @id @default(uuid(7)) @db.Uuid
  /// Trimmed and lowercased.
  email               String
  displayName         String        @map("display_name")
  department          String?
  employeeLevel       EmployeeLevel @map("employee_level")
  /// Role ids to assign on acceptance (JSON array of UUID strings).
  roleIdsJson         Json          @map("role_ids_json")
  invitedByEmployeeId String        @map("invited_by_employee_id") @db.Uuid
  tokenHash           String        @unique @map("token_hash")
  expiresAt           DateTime      @map("expires_at") @db.Timestamptz(3)
  acceptedAt          DateTime?     @map("accepted_at") @db.Timestamptz(3)
  acceptedEmployeeId  String?       @unique @map("accepted_employee_id") @db.Uuid
  revokedAt           DateTime?     @map("revoked_at") @db.Timestamptz(3)
  revokedByEmployeeId String?       @map("revoked_by_employee_id") @db.Uuid
  createdAt           DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  invitedBy        Employee  @relation("InvitationInvitedBy", fields: [invitedByEmployeeId], references: [id])
  revokedBy        Employee? @relation("InvitationRevokedBy", fields: [revokedByEmployeeId], references: [id])
  acceptedEmployee Employee? @relation("InvitationAcceptedAs", fields: [acceptedEmployeeId], references: [id])

  @@index([email])
  @@map("employee_invitations")
}

// ---------------------------------------------------------------------------
// Settings (DB design §20 + "v1.2 TASK-004 Amendments"; TASK-004, ADR-0017).
// `setting_history` and the settings screen come with TASK-057.
// ---------------------------------------------------------------------------

enum SettingDataType {
  INTEGER
  BOOLEAN
  STRING
  JSON

  @@map("setting_data_type")
}

/// One Owner/Admin-configurable value (Q179). The known keys, their types and
/// defaults are listed in src/server/modules/settings/settings.ts; the
/// bootstrap inserts missing keys and never overwrites a stored value.
model Setting {
  key                 String          @id
  valueJson           Json            @map("value_json")
  dataType            SettingDataType @map("data_type")
  /// Null for values written by the bootstrap.
  updatedByEmployeeId String?         @map("updated_by_employee_id") @db.Uuid
  updatedAt           DateTime        @default(now()) @map("updated_at") @db.Timestamptz(3)

  updatedBy Employee? @relation("SettingUpdatedBy", fields: [updatedByEmployeeId], references: [id])

  @@map("settings")
}

// ---------------------------------------------------------------------------
// Audit logs and approval requests (DB design §20 + v1.1 "approval_requests"
// + "v1.2 TASK-013 Amendments"; TASK-013, ADR-0018)
// ---------------------------------------------------------------------------

enum AuditActorType {
  SYSTEM
  EMPLOYEE
  CUSTOMER

  @@map("audit_actor_type")
}

/// One important business action (Q70, Architecture §19). Append-only: a
/// database trigger rejects every UPDATE and DELETE (ADR-0018). Snapshots
/// never contain passwords, password hashes, codes or tokens.
model AuditLog {
  id               String         @id @default(uuid(7)) @db.Uuid
  actorType        AuditActorType @map("actor_type")
  /// Employee id or customer id; null for SYSTEM.
  actorId          String?        @map("actor_id") @db.Uuid
  /// Stable action code, e.g. ROLE_UPDATED (src/server/modules/audit/audit.ts).
  action           String
  entityType       String         @map("entity_type")
  /// Text so that entities keyed by something other than a UUID (a setting
  /// key) can be audited.
  entityId         String         @map("entity_id")
  previousDataJson Json?          @map("previous_data_json")
  newDataJson      Json?          @map("new_data_json")
  reason           String?
  /// The request id of the API call that made the change.
  correlationId    String?        @map("correlation_id")
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([entityType, entityId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@index([actorType, actorId, createdAt(sort: Desc)])
  @@map("audit_logs")
}

/// What a request asks to approve (Business Spec R19, permission catalog D-07).
enum ApprovalType {
  PURCHASE_ORDER
  PURCHASE_OVER_DELIVERY
  MARKETING_CAMPAIGN
  CRITICAL_SETTING

  @@map("approval_type")
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED

  @@map("approval_status")
}

/// A pending action waiting for Owner/Admin approval (Audit Correction 7,
/// User Flows §17.3). Created by the feature that needs it; resolved through
/// /admin/approval-requests. At most one PENDING request per type and entity.
model ApprovalRequest {
  id                    String         @id @default(uuid(7)) @db.Uuid
  approvalType          ApprovalType   @map("approval_type")
  entityType            String         @map("entity_type")
  entityId              String         @map("entity_id")
  requestedByEmployeeId String         @map("requested_by_employee_id") @db.Uuid
  status                ApprovalStatus @default(PENDING)
  requestedAt           DateTime       @default(now()) @map("requested_at") @db.Timestamptz(3)
  resolvedByEmployeeId  String?        @map("resolved_by_employee_id") @db.Uuid
  resolvedAt            DateTime?      @map("resolved_at") @db.Timestamptz(3)
  /// Why the requester asks for the action.
  reason                String?
  /// Why the request was approved, rejected or cancelled (required to reject).
  resolutionReason      String?        @map("resolution_reason")
  /// What will happen on approval, as recorded by the feature (e.g. old and
  /// new value of a setting).
  metadataJson          Json?          @map("metadata_json")

  requestedBy Employee  @relation("ApprovalRequestedBy", fields: [requestedByEmployeeId], references: [id])
  resolvedBy  Employee? @relation("ApprovalResolvedBy", fields: [resolvedByEmployeeId], references: [id])

  @@unique([approvalType, entityType, entityId], map: "approval_requests_one_pending_key", where: raw("status = 'PENDING'"))
  @@index([status, requestedAt])
  @@index([entityType, entityId])
  @@map("approval_requests")
}

// ---------------------------------------------------------------------------
// Catalog: products and variants (DB design §5 "products", "product_variants",
// "Variant canonicalization"; Business Spec C6, Q75; TASK-014, ADR-0019).
// Brands, categories, media, prices and costs are added by TASK-015..018.
// ---------------------------------------------------------------------------

/// Product lifecycle (User Flows §4.1). TASK-014 creates DRAFT products only;
/// the transitions belong to TASK-017.
enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
  DISABLED

  @@map("product_status")
}

enum ProductVariantStatus {
  ACTIVE
  ARCHIVED

  @@map("product_variant_status")
}

/// The container shown to customers (C6). Never hard-deleted (Q75): a
/// database trigger rejects DELETE.
model Product {
  id            String        @id @default(uuid(7)) @db.Uuid
  nameAr        String        @map("name_ar")
  nameEn        String        @map("name_en")
  /// Unique, lowercase Latin letters, digits and hyphens.
  slug          String        @unique
  descriptionAr String?       @map("description_ar")
  descriptionEn String?       @map("description_en")
  /// Optional; a product has at most one brand (TASK-015).
  brandId       String?       @map("brand_id") @db.Uuid
  status        ProductStatus @default(DRAFT)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime      @default(now()) @map("updated_at") @db.Timestamptz(3)
  archivedAt    DateTime?     @map("archived_at") @db.Timestamptz(3)

  brand      Brand?            @relation(fields: [brandId], references: [id], onDelete: Restrict)
  variants   ProductVariant[]
  categories ProductCategory[]
  media      ProductMedia[]

  @@index([status, createdAt(sort: Desc)])
  @@index([brandId])
  @@map("products")
}

/// The canonical sellable unit (C6): SKU, and later price, cost and stock,
/// live here. Every product has exactly one default variant. Never
/// hard-deleted: archived instead.
model ProductVariant {
  id             String               @id @default(uuid(7)) @db.Uuid
  productId      String               @map("product_id") @db.Uuid
  /// Unique across all variants, archived ones included; stored uppercase.
  sku            String               @unique
  isDefault      Boolean              @default(false) @map("is_default")
  /// Null for a variant without visible options (a simple product).
  variantNameAr  String?              @map("variant_name_ar")
  variantNameEn  String?              @map("variant_name_en")
  /// Option values such as {"shade": "Rose", "size": "50 ml"}.
  attributesJson Json?                @map("attributes_json")
  status         ProductVariantStatus @default(ACTIVE)
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime             @default(now()) @map("updated_at") @db.Timestamptz(3)
  archivedAt     DateTime?            @map("archived_at") @db.Timestamptz(3)

  product Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  media   ProductMedia[]

  @@unique([productId], map: "product_variants_one_default_key", where: raw("is_default"))
  @@index([productId, createdAt])
  @@map("product_variants")
}

// ---------------------------------------------------------------------------
// Brands and categories (TASK-015, DB design §5, ADR-0020)
// ---------------------------------------------------------------------------

enum TaxonomyStatus {
  ACTIVE
  INACTIVE

  @@map("taxonomy_status")
}

model Brand {
  id            String         @id @default(uuid(7)) @db.Uuid
  nameAr        String         @map("name_ar")
  nameEn        String         @map("name_en")
  /// Unique, lowercase Latin letters, digits and hyphens.
  slug          String         @unique
  descriptionAr String?        @map("description_ar")
  descriptionEn String?        @map("description_en")
  status        TaxonomyStatus @default(ACTIVE)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime       @default(now()) @map("updated_at") @db.Timestamptz(3)

  products Product[]

  @@index([status, nameEn])
  @@map("brands")
}

model Category {
  id        String         @id @default(uuid(7)) @db.Uuid
  nameAr    String         @map("name_ar")
  nameEn    String         @map("name_en")
  /// Lowercase Latin letters, digits and hyphens; unique among siblings.
  slug      String
  /// Null for a top-level category.
  parentId  String?        @map("parent_id") @db.Uuid
  status    TaxonomyStatus @default(ACTIVE)
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime       @default(now()) @map("updated_at") @db.Timestamptz(3)

  parent   Category?         @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children Category[]        @relation("CategoryTree")
  products ProductCategory[]

  @@unique([slug], map: "categories_top_level_slug_key", where: raw("parent_id IS NULL"))
  @@unique([parentId, slug], map: "categories_parent_slug_key", where: raw("parent_id IS NOT NULL"))
  @@index([parentId])
  @@map("categories")
}

/// Which categories a product is listed in (many-to-many).
model ProductCategory {
  productId  String   @map("product_id") @db.Uuid
  categoryId String   @map("category_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  product  Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@id([productId, categoryId])
  @@index([categoryId])
  @@map("product_categories")
}

// ---------------------------------------------------------------------------
// Media storage and product media (DB design §5 "product_media", §6
// "media_assets"; Business Spec Q175-Q178; TASK-016, ADR-0021)
// ---------------------------------------------------------------------------

/// Result of the security checks on an uploaded file (DB design §6).
enum MediaScanStatus {
  PENDING
  SAFE
  REJECTED

  @@map("media_scan_status")
}

/// What an upload is for; it decides who may upload and see the file.
enum MediaPurpose {
  PRODUCT_MEDIA

  @@map("media_purpose")
}

/// One uploaded file (API §28). The bytes live in file storage, never in
/// PostgreSQL. A row is created when an upload starts (PENDING) and becomes
/// SAFE or REJECTED when it is completed. Never hard-deleted.
model MediaAsset {
  id                  String          @id @default(uuid(7)) @db.Uuid
  /// Which storage holds the bytes, e.g. LOCAL (ADR-0021).
  storageProvider     String          @map("storage_provider")
  /// Generated by the server; never derived from the uploaded file name.
  objectKey           String          @unique @map("object_key")
  originalFilename    String          @map("original_filename")
  /// Declared when the upload starts; confirmed from the file's content.
  mimeType            String          @map("mime_type")
  /// Declared when the upload starts; the actual size once completed.
  sizeBytes           Int             @map("size_bytes")
  width               Int?
  height              Int?
  /// SHA-256 of the file (hex), set when completed.
  checksum            String?
  scanStatus          MediaScanStatus @default(PENDING) @map("scan_status")
  purpose             MediaPurpose
  /// Why the file was refused (an issue code such as file_type_mismatch).
  rejectionReason     String?         @map("rejection_reason")
  /// SHA-256 of the single-use upload token; cleared once the upload is completed.
  uploadTokenHash     String?         @unique @map("upload_token_hash")
  uploadExpiresAt     DateTime        @map("upload_expires_at") @db.Timestamptz(3)
  /// When the bytes were last received.
  uploadedAt          DateTime?       @map("uploaded_at") @db.Timestamptz(3)
  completedAt         DateTime?       @map("completed_at") @db.Timestamptz(3)
  createdByEmployeeId String?         @map("created_by_employee_id") @db.Uuid
  createdAt           DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  createdBy    Employee?      @relation("MediaAssetCreatedBy", fields: [createdByEmployeeId], references: [id], onDelete: Restrict)
  productMedia ProductMedia[]

  @@index([createdByEmployeeId, createdAt])
  @@map("media_assets")
}

/// An image shown on a product, optionally for one variant (DB design §5).
/// Removing it sets `removed_at`; the row and the file are kept for history.
model ProductMedia {
  id           String    @id @default(uuid(7)) @db.Uuid
  productId    String    @map("product_id") @db.Uuid
  /// Null for an image of the whole product.
  variantId    String?   @map("variant_id") @db.Uuid
  mediaAssetId String    @map("media_asset_id") @db.Uuid
  /// 0-based position among the product's images that are not removed.
  sortOrder    Int       @map("sort_order")
  isMain       Boolean   @default(false) @map("is_main")
  altTextAr    String?   @map("alt_text_ar")
  altTextEn    String?   @map("alt_text_en")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)
  removedAt    DateTime? @map("removed_at") @db.Timestamptz(3)

  product    Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant    ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Restrict)
  mediaAsset MediaAsset      @relation(fields: [mediaAssetId], references: [id], onDelete: Restrict)

  @@unique([productId], map: "product_media_one_main_key", where: raw("is_main AND removed_at IS NULL"))
  @@unique([productId, mediaAssetId], map: "product_media_asset_once_key", where: raw("removed_at IS NULL"))
  @@index([productId, sortOrder])
  @@index([mediaAssetId])
  @@index([variantId])
  @@map("product_media")
}
