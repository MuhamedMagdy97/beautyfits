// BeautyFits Prisma schema.
//
// Models are added by their owning tasks (TASK-003 onward) following
// docs/database/database-design.md. Conventions (ADR-0003):
// - money columns are integer minor units (BigInt/Int), never Float/Decimal
// - ids are UUIDv7 generated by the client: @id @default(uuid(7)) @db.Uuid (ADR-0010)
// - timestamps are stored in UTC
// - tables use snake_case names via @@map / @map

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Shared kernel (DB design v1.2 "Reliability"; TASK-003)
// ---------------------------------------------------------------------------

enum IdempotencyStatus {
  IN_PROGRESS
  COMPLETED
  FAILED

  @@map("idempotency_status")
}

/// Stored result of a retry-sensitive operation (API §9). A repeated request
/// with the same scope + operation + key returns the stored result.
model IdempotencyKey {
  id                 String            @id @default(uuid(7)) @db.Uuid
  /// Who the key belongs to, e.g. "EMPLOYEE:<id>", "CUSTOMER:<id>", "GUEST_CART:<token>".
  scope              String
  /// Operation name, e.g. "WALLET_ADJUSTMENT", "RETURN_COMPLETE", "WEBHOOK:<provider>".
  operation          String
  key                String
  requestFingerprint String            @map("request_fingerprint")
  status             IdempotencyStatus @default(IN_PROGRESS)
  responseStatus     Int?              @map("response_status")
  responseBody       Json?             @map("response_body_json")
  resourceType       String?           @map("resource_type")
  resourceId         String?           @map("resource_id") @db.Uuid
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt          DateTime          @map("expires_at") @db.Timestamptz(3)

  @@unique([scope, operation, key])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

enum OutboxStatus {
  PENDING
  PROCESSING
  DONE
  FAILED

  @@map("outbox_status")
}

/// Event written in the same transaction as a business change and delivered
/// by a worker after commit (Architecture v1.2 additions).
model OutboxEvent {
  id            String       @id @default(uuid(7)) @db.Uuid
  eventType     String       @map("event_type")
  aggregateType String       @map("aggregate_type")
  aggregateId   String       @map("aggregate_id") @db.Uuid
  payload       Json         @map("payload_json")
  status        OutboxStatus @default(PENDING)
  attemptCount  Int          @default(0) @map("attempt_count")
  availableAt   DateTime     @default(now()) @map("available_at") @db.Timestamptz(3)
  lastError     String?      @map("last_error")
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  processedAt   DateTime?    @map("processed_at") @db.Timestamptz(3)

  @@index([status, availableAt])
  @@map("outbox_events")
}
