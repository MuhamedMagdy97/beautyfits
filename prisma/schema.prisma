// BeautyFits Prisma schema.
//
// Models are added by their owning tasks (TASK-003 onward) following
// docs/database/database-design.md. Conventions (ADR-0003):
// - money columns are integer minor units (BigInt/Int), never Float/Decimal
// - ids are UUIDv7 generated by the client: @id @default(uuid(7)) @db.Uuid (ADR-0010)
// - timestamps are stored in UTC
// - tables use snake_case names via @@map / @map

generator client {
  previewFeatures = ["partialIndexes"]
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Shared kernel (DB design v1.2 "Reliability"; TASK-003)
// ---------------------------------------------------------------------------

enum IdempotencyStatus {
  IN_PROGRESS
  COMPLETED
  FAILED

  @@map("idempotency_status")
}

/// Stored result of a retry-sensitive operation (API §9). A repeated request
/// with the same scope + operation + key returns the stored result.
model IdempotencyKey {
  id                 String            @id @default(uuid(7)) @db.Uuid
  /// Who the key belongs to, e.g. "EMPLOYEE:<id>", "CUSTOMER:<id>", "GUEST_CART:<token>".
  scope              String
  /// Operation name, e.g. "WALLET_ADJUSTMENT", "RETURN_COMPLETE", "WEBHOOK:<provider>".
  operation          String
  key                String
  requestFingerprint String            @map("request_fingerprint")
  status             IdempotencyStatus @default(IN_PROGRESS)
  responseStatus     Int?              @map("response_status")
  responseBody       Json?             @map("response_body_json")
  resourceType       String?           @map("resource_type")
  resourceId         String?           @map("resource_id") @db.Uuid
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt          DateTime          @map("expires_at") @db.Timestamptz(3)

  @@unique([scope, operation, key])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

enum OutboxStatus {
  PENDING
  PROCESSING
  DONE
  FAILED

  @@map("outbox_status")
}

/// Event written in the same transaction as a business change and delivered
/// by a worker after commit (Architecture v1.2 additions).
model OutboxEvent {
  id            String       @id @default(uuid(7)) @db.Uuid
  eventType     String       @map("event_type")
  aggregateType String       @map("aggregate_type")
  aggregateId   String       @map("aggregate_id") @db.Uuid
  payload       Json         @map("payload_json")
  status        OutboxStatus @default(PENDING)
  attemptCount  Int          @default(0) @map("attempt_count")
  availableAt   DateTime     @default(now()) @map("available_at") @db.Timestamptz(3)
  lastError     String?      @map("last_error")
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  processedAt   DateTime?    @map("processed_at") @db.Timestamptz(3)

  @@index([status, availableAt])
  @@map("outbox_events")
}

// ---------------------------------------------------------------------------
// Identity & customer authentication (DB design v1.2 §3 + "v1.2 TASK-007
// Amendments"; TASK-007, ADR-0013)
// ---------------------------------------------------------------------------

enum AccountType {
  CUSTOMER
  EMPLOYEE

  @@map("account_type")
}

enum AccountStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  DEACTIVATED

  @@map("account_status")
}

enum Locale {
  ar
  en

  @@map("locale")
}

enum AuthDomain {
  CUSTOMER
  EMPLOYEE

  @@map("auth_domain")
}

enum SessionRevokeReason {
  LOGOUT
  LOGOUT_ALL
  PASSWORD_CHANGE
  PASSWORD_RESET
  DEACTIVATED
  REUSE_DETECTED

  @@map("session_revoke_reason")
}

/// Authentication identity (DB design §3.1). A normalized email is unique per
/// account type only once verified (Business Spec R15, TASK-007 owner decision):
/// unverified PENDING_VERIFICATION accounts never reserve an email.
model Account {
  id                String        @id @default(uuid(7)) @db.Uuid
  accountType       AccountType   @map("account_type")
  /// Trimmed and lowercased.
  email             String
  emailVerifiedAt   DateTime?     @map("email_verified_at") @db.Timestamptz(3)
  /// scrypt hash with its parameters (ADR-0013); never the password.
  passwordHash      String        @map("password_hash")
  passwordChangedAt DateTime      @default(now()) @map("password_changed_at") @db.Timestamptz(3)
  status            AccountStatus @default(PENDING_VERIFICATION)
  lastLoginAt       DateTime?     @map("last_login_at") @db.Timestamptz(3)
  deactivatedAt     DateTime?     @map("deactivated_at") @db.Timestamptz(3)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  customer       Customer?
  employee       Employee?
  sessions       AuthSession[]
  otpChallenges  OtpChallenge[]
  trustedDevices EmployeeTrustedDevice[]

  @@unique([accountType, email], map: "accounts_verified_email_key", where: raw("email_verified_at IS NOT NULL"))
  @@index([accountType, email])
  @@map("accounts")
}

/// Customer profile (DB design §3.2). The phone is an Egyptian mobile number in
/// E.164 (Business Spec R27), unique only once verified.
model Customer {
  id              String    @id @default(uuid(7)) @db.Uuid
  accountId       String?   @unique @map("account_id") @db.Uuid
  /// E.164, e.g. +201012345678.
  phone           String
  phoneVerifiedAt DateTime? @map("phone_verified_at") @db.Timestamptz(3)
  fullName        String    @map("full_name")
  preferredLocale Locale    @default(ar) @map("preferred_locale")
  dateOfBirth     DateTime? @map("date_of_birth") @db.Date
  /// Set when the customer deactivated the account and the profile was wiped (Q154, R34).
  anonymizedAt    DateTime? @map("anonymized_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  account        Account?          @relation(fields: [accountId], references: [id])
  addresses      CustomerAddress[]
  carts          Cart[]
  discountUsages DiscountUsage[]
  wallet         Wallet?
  orders         Order[]
  reviews        Review[]
  reviewReports  ReviewReport[]

  @@unique([phone], map: "customers_verified_phone_key", where: raw("phone_verified_at IS NOT NULL"))
  @@index([phone])
  @@map("customers")
}

/// One login on one device: a refresh-token family (ADR-0008, ADR-0013).
/// Revoking the session invalidates every token issued for it.
model AuthSession {
  id           String               @id @default(uuid(7)) @db.Uuid
  accountId    String               @map("account_id") @db.Uuid
  domain       AuthDomain
  createdAt    DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  lastUsedAt   DateTime             @default(now()) @map("last_used_at") @db.Timestamptz(3)
  /// Absolute end of the session (customers: 30 days after login, Q162).
  expiresAt    DateTime             @map("expires_at") @db.Timestamptz(3)
  revokedAt    DateTime?            @map("revoked_at") @db.Timestamptz(3)
  revokeReason SessionRevokeReason? @map("revoke_reason")
  ipAddress    String?              @map("ip_address")
  userAgent    String?              @map("user_agent")

  account Account            @relation(fields: [accountId], references: [id])
  tokens  AuthSessionToken[]

  @@index([accountId, revokedAt])
  @@map("auth_sessions")
}

/// One issued access/refresh token pair. Only SHA-256 hashes are stored.
/// A pair is superseded (`rotated_at`) when its refresh token is used;
/// presenting a superseded refresh token again is reuse (ADR-0013).
model AuthSessionToken {
  id               String    @id @default(uuid(7)) @db.Uuid
  sessionId        String    @map("session_id") @db.Uuid
  accessTokenHash  String    @unique @map("access_token_hash")
  refreshTokenHash String    @unique @map("refresh_token_hash")
  accessExpiresAt  DateTime  @map("access_expires_at") @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  rotatedAt        DateTime? @map("rotated_at") @db.Timestamptz(3)

  session AuthSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("auth_session_tokens")
}

/// Throttling counter shared by all app instances (ADR-0013). Keys are
/// namespaced, e.g. "login:account:<sha256(email)>", "login:ip:<ip>".
model RateLimitBucket {
  key             String    @id
  count           Int
  windowStartedAt DateTime  @map("window_started_at") @db.Timestamptz(3)
  blockedUntil    DateTime? @map("blocked_until") @db.Timestamptz(3)
  updatedAt       DateTime  @map("updated_at") @db.Timestamptz(3)

  @@index([updatedAt])
  @@map("rate_limit_buckets")
}

// ---------------------------------------------------------------------------
// One-time codes (DB design v1.2 "otp_challenges" + "TASK-008 Amendments";
// TASK-008, ADR-0014)
// ---------------------------------------------------------------------------

enum OtpPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  EMPLOYEE_LOGIN
  EMAIL_CHANGE
  PHONE_CHANGE
  PHONE_VERIFICATION
  GUEST_ORDER_CLAIM

  @@map("otp_purpose")
}

enum OtpChannel {
  EMAIL
  WHATSAPP

  @@map("otp_channel")
}

/// One issued one-time code. Only a hash of the code is stored. A challenge
/// is usable once, until `expires_at`, for at most `max_attempts` wrong
/// guesses; issuing a new code for the same purpose supersedes it.
model OtpChallenge {
  id             String     @id @default(uuid(7)) @db.Uuid
  accountId      String?    @map("account_id") @db.Uuid
  purpose        OtpPurpose
  channel        OtpChannel
  /// Normalized email (or phone for future channels).
  destination    String
  /// SHA-256 of "<id>:<code>".
  codeHash       String     @map("code_hash")
  attemptCount   Int        @default(0) @map("attempt_count")
  maxAttempts    Int        @map("max_attempts")
  expiresAt      DateTime   @map("expires_at") @db.Timestamptz(3)
  lastSentAt     DateTime   @map("last_sent_at") @db.Timestamptz(3)
  consumedAt     DateTime?  @map("consumed_at") @db.Timestamptz(3)
  supersededAt   DateTime?  @map("superseded_at") @db.Timestamptz(3)
  /// Single-use grant tied to the code. PASSWORD_RESET: the reset token issued
  /// when the code is verified. EMPLOYEE_LOGIN: the login ticket issued with
  /// the code after the password check (TASK-011).
  grantTokenHash String?    @unique @map("grant_token_hash")
  grantExpiresAt DateTime?  @map("grant_expires_at") @db.Timestamptz(3)
  grantUsedAt    DateTime?  @map("grant_used_at") @db.Timestamptz(3)
  /// The value a code confirms when it is not the destination: PHONE_CHANGE
  /// keeps the new phone here (the code goes to the account email, R30).
  pendingValue   String?    @map("pending_value")
  ipAddress      String?    @map("ip_address")
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)

  account Account? @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([purpose, destination, createdAt])
  @@index([accountId])
  @@map("otp_challenges")
}

// ---------------------------------------------------------------------------
// Employees and employee authentication (DB design §4 + "v1.2 TASK-011
// Amendments"; TASK-011, ADR-0015). Roles and permissions: TASK-012.
// ---------------------------------------------------------------------------

enum EmployeeLevel {
  OWNER
  ADMIN
  MANAGER
  EMPLOYEE

  @@map("employee_level")
}

enum EmployeeStatus {
  ACTIVE
  DEACTIVATED

  @@map("employee_status")
}

/// Staff profile (DB design §4). Never hard-deleted once it has business
/// history; access is removed by deactivation (Q64, Q69).
model Employee {
  id                  String         @id @default(uuid(7)) @db.Uuid
  accountId           String         @unique @map("account_id") @db.Uuid
  displayName         String         @map("display_name")
  employeeLevel       EmployeeLevel  @map("employee_level")
  department          String?
  status              EmployeeStatus @default(ACTIVE)
  createdByEmployeeId String?        @map("created_by_employee_id") @db.Uuid
  deactivatedAt       DateTime?      @map("deactivated_at") @db.Timestamptz(3)
  createdAt           DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  account   Account    @relation(fields: [accountId], references: [id])
  createdBy Employee?  @relation("EmployeeCreatedBy", fields: [createdByEmployeeId], references: [id])
  created   Employee[] @relation("EmployeeCreatedBy")

  roles                 EmployeeRole[]          @relation("EmployeeRoleHolder")
  rolesAssigned         EmployeeRole[]          @relation("EmployeeRoleAssigner")
  rolesCreated          Role[]                  @relation("RoleCreatedBy")
  invitationsSent       EmployeeInvitation[]    @relation("InvitationInvitedBy")
  invitationsRevoked    EmployeeInvitation[]    @relation("InvitationRevokedBy")
  invitation            EmployeeInvitation?     @relation("InvitationAcceptedAs")
  settingsUpdated       Setting[]               @relation("SettingUpdatedBy")
  approvalsRequested    ApprovalRequest[]       @relation("ApprovalRequestedBy")
  approvalsResolved     ApprovalRequest[]       @relation("ApprovalResolvedBy")
  mediaUploaded         MediaAsset[]            @relation("MediaAssetCreatedBy")
  purchasesCreated      PurchaseOrder[]         @relation("PurchaseOrderCreatedBy")
  purchasesApproved     PurchaseOrder[]         @relation("PurchaseOrderApprovedBy")
  purchasesCancelled    PurchaseOrder[]         @relation("PurchaseOrderCancelledBy")
  purchasesClosed       PurchaseOrder[]         @relation("PurchaseOrderClosedBy")
  goodsReceipts         GoodsReceipt[]          @relation("GoodsReceiptReceivedBy")
  invoicesRecorded      PurchaseInvoice[]       @relation("PurchaseInvoiceRecordedBy")
  returnsCreated        SupplierReturn[]        @relation("SupplierReturnCreatedBy")
  returnsApproved       SupplierReturn[]        @relation("SupplierReturnApprovedBy")
  returnsSettled        SupplierReturn[]        @relation("SupplierReturnSettledBy")
  paymentsRecorded      SupplierPayment[]       @relation("SupplierPaymentRecordedBy")
  ledgerEntries         SupplierLedgerEntry[]   @relation("SupplierLedgerEntryCreatedBy")
  discountsCreated      Discount[]              @relation("DiscountCreatedBy")
  codPhoneConfirmations Order[]                 @relation("OrderCodConfirmationRecordedBy")
  reviewModerations     ReviewModerationEvent[]

  @@index([status, employeeLevel])
  @@map("employees")
}

/// A device on which an employee completed the login email code (Business
/// Spec R28). Logins on it skip the code until `expires_at` (30 days after
/// the code). Only a SHA-256 hash of the device token is stored.
model EmployeeTrustedDevice {
  id              String    @id @default(uuid(7)) @db.Uuid
  accountId       String    @map("account_id") @db.Uuid
  deviceTokenHash String    @unique @map("device_token_hash")
  verifiedAt      DateTime  @map("verified_at") @db.Timestamptz(3)
  expiresAt       DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt       DateTime? @map("revoked_at") @db.Timestamptz(3)
  ipAddress       String?   @map("ip_address")
  userAgent       String?   @map("user_agent")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  account Account @relation(fields: [accountId], references: [id])

  @@index([accountId])
  @@map("employee_trusted_devices")
}

// ---------------------------------------------------------------------------
// Roles, permissions and invitations (TASK-012, DB design §4, ADR-0016)

/// A named set of permissions (Q66, Q67). Custom roles are created and edited
/// by Owner/Admin (User Flows §17.1); system roles are fixed and not
/// assignable through the API. Roles are never deleted.
model Role {
  id                  String   @id @default(uuid(7)) @db.Uuid
  /// Trimmed; unique ignoring case (checked by the service under a lock).
  name                String   @unique
  description         String?
  isSystemRole        Boolean  @default(false) @map("is_system_role")
  createdByEmployeeId String?  @map("created_by_employee_id") @db.Uuid
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  createdBy   Employee?        @relation("RoleCreatedBy", fields: [createdByEmployeeId], references: [id])
  permissions RolePermission[]
  employees   EmployeeRole[]

  @@map("roles")
}

/// The permission catalog (docs/security/permission-catalog.md). Rows are
/// inserted by migrations; the code list in src/server/modules/rbac/catalog.ts
/// must match them.
model Permission {
  id          String @id @default(uuid(7)) @db.Uuid
  code        String @unique
  description String

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model EmployeeRole {
  employeeId           String   @map("employee_id") @db.Uuid
  roleId               String   @map("role_id") @db.Uuid
  assignedByEmployeeId String?  @map("assigned_by_employee_id") @db.Uuid
  assignedAt           DateTime @default(now()) @map("assigned_at") @db.Timestamptz(3)

  employee   Employee  @relation("EmployeeRoleHolder", fields: [employeeId], references: [id])
  role       Role      @relation(fields: [roleId], references: [id])
  assignedBy Employee? @relation("EmployeeRoleAssigner", fields: [assignedByEmployeeId], references: [id])

  @@id([employeeId, roleId])
  @@index([roleId])
  @@map("employee_roles")
}

/// An invitation to join the staff by work email (Q64). Only a SHA-256 hash
/// of the invitation token is stored. Accepting it creates the employee
/// account with the level and roles chosen by the inviter.
model EmployeeInvitation {
  id                  String        @id @default(uuid(7)) @db.Uuid
  /// Trimmed and lowercased.
  email               String
  displayName         String        @map("display_name")
  department          String?
  employeeLevel       EmployeeLevel @map("employee_level")
  /// Role ids to assign on acceptance (JSON array of UUID strings).
  roleIdsJson         Json          @map("role_ids_json")
  invitedByEmployeeId String        @map("invited_by_employee_id") @db.Uuid
  tokenHash           String        @unique @map("token_hash")
  expiresAt           DateTime      @map("expires_at") @db.Timestamptz(3)
  acceptedAt          DateTime?     @map("accepted_at") @db.Timestamptz(3)
  acceptedEmployeeId  String?       @unique @map("accepted_employee_id") @db.Uuid
  revokedAt           DateTime?     @map("revoked_at") @db.Timestamptz(3)
  revokedByEmployeeId String?       @map("revoked_by_employee_id") @db.Uuid
  createdAt           DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  invitedBy        Employee  @relation("InvitationInvitedBy", fields: [invitedByEmployeeId], references: [id])
  revokedBy        Employee? @relation("InvitationRevokedBy", fields: [revokedByEmployeeId], references: [id])
  acceptedEmployee Employee? @relation("InvitationAcceptedAs", fields: [acceptedEmployeeId], references: [id])

  @@index([email])
  @@map("employee_invitations")
}

// ---------------------------------------------------------------------------
// Settings (DB design §20 + "v1.2 TASK-004 Amendments"; TASK-004, ADR-0017).
// `setting_history` and the settings screen come with TASK-057.
// ---------------------------------------------------------------------------

enum SettingDataType {
  INTEGER
  BOOLEAN
  STRING
  JSON

  @@map("setting_data_type")
}

/// One Owner/Admin-configurable value (Q179). The known keys, their types and
/// defaults are listed in src/server/modules/settings/settings.ts; the
/// bootstrap inserts missing keys and never overwrites a stored value.
model Setting {
  key                 String          @id
  valueJson           Json            @map("value_json")
  dataType            SettingDataType @map("data_type")
  /// Null for values written by the bootstrap.
  updatedByEmployeeId String?         @map("updated_by_employee_id") @db.Uuid
  updatedAt           DateTime        @default(now()) @map("updated_at") @db.Timestamptz(3)

  updatedBy Employee? @relation("SettingUpdatedBy", fields: [updatedByEmployeeId], references: [id])

  @@map("settings")
}

// ---------------------------------------------------------------------------
// Audit logs and approval requests (DB design §20 + v1.1 "approval_requests"
// + "v1.2 TASK-013 Amendments"; TASK-013, ADR-0018)
// ---------------------------------------------------------------------------

enum AuditActorType {
  SYSTEM
  EMPLOYEE
  CUSTOMER

  @@map("audit_actor_type")
}

/// One important business action (Q70, Architecture §19). Append-only: a
/// database trigger rejects every UPDATE and DELETE (ADR-0018). Snapshots
/// never contain passwords, password hashes, codes or tokens.
model AuditLog {
  id               String         @id @default(uuid(7)) @db.Uuid
  actorType        AuditActorType @map("actor_type")
  /// Employee id or customer id; null for SYSTEM.
  actorId          String?        @map("actor_id") @db.Uuid
  /// Stable action code, e.g. ROLE_UPDATED (src/server/modules/audit/audit.ts).
  action           String
  entityType       String         @map("entity_type")
  /// Text so that entities keyed by something other than a UUID (a setting
  /// key) can be audited.
  entityId         String         @map("entity_id")
  previousDataJson Json?          @map("previous_data_json")
  newDataJson      Json?          @map("new_data_json")
  reason           String?
  /// The request id of the API call that made the change.
  correlationId    String?        @map("correlation_id")
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([entityType, entityId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@index([actorType, actorId, createdAt(sort: Desc)])
  @@map("audit_logs")
}

/// What a request asks to approve (Business Spec R19, permission catalog D-07).
enum ApprovalType {
  PURCHASE_ORDER
  PURCHASE_OVER_DELIVERY
  /// Owner review of a supplier return (TASK-024, Q105).
  SUPPLIER_RETURN
  MARKETING_CAMPAIGN
  CRITICAL_SETTING

  @@map("approval_type")
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED

  @@map("approval_status")
}

/// A pending action waiting for Owner/Admin approval (Audit Correction 7,
/// User Flows §17.3). Created by the feature that needs it; resolved through
/// /admin/approval-requests. At most one PENDING request per type and entity.
model ApprovalRequest {
  id                    String         @id @default(uuid(7)) @db.Uuid
  approvalType          ApprovalType   @map("approval_type")
  entityType            String         @map("entity_type")
  entityId              String         @map("entity_id")
  requestedByEmployeeId String         @map("requested_by_employee_id") @db.Uuid
  status                ApprovalStatus @default(PENDING)
  requestedAt           DateTime       @default(now()) @map("requested_at") @db.Timestamptz(3)
  resolvedByEmployeeId  String?        @map("resolved_by_employee_id") @db.Uuid
  resolvedAt            DateTime?      @map("resolved_at") @db.Timestamptz(3)
  /// Why the requester asks for the action.
  reason                String?
  /// Why the request was approved, rejected or cancelled (required to reject).
  resolutionReason      String?        @map("resolution_reason")
  /// What will happen on approval, as recorded by the feature (e.g. old and
  /// new value of a setting).
  metadataJson          Json?          @map("metadata_json")

  requestedBy Employee  @relation("ApprovalRequestedBy", fields: [requestedByEmployeeId], references: [id])
  resolvedBy  Employee? @relation("ApprovalResolvedBy", fields: [resolvedByEmployeeId], references: [id])

  @@unique([approvalType, entityType, entityId], map: "approval_requests_one_pending_key", where: raw("status = 'PENDING'"))
  @@index([status, requestedAt])
  @@index([entityType, entityId])
  @@map("approval_requests")
}

// ---------------------------------------------------------------------------
// Catalog: products and variants (DB design §5 "products", "product_variants",
// "Variant canonicalization"; Business Spec C6, Q75; TASK-014, ADR-0019).
// Brands, categories, media, prices and costs are added by TASK-015..018.
// ---------------------------------------------------------------------------

/// Product lifecycle (User Flows §4.1). TASK-014 creates DRAFT products only;
/// the transitions belong to TASK-017.
enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
  DISABLED

  @@map("product_status")
}

enum ProductVariantStatus {
  ACTIVE
  ARCHIVED

  @@map("product_variant_status")
}

/// The container shown to customers (C6). Never hard-deleted (Q75): a
/// database trigger rejects DELETE.
model Product {
  id                String        @id @default(uuid(7)) @db.Uuid
  nameAr            String        @map("name_ar")
  nameEn            String        @map("name_en")
  /// Unique, lowercase Latin letters, digits and hyphens.
  slug              String        @unique
  descriptionAr     String?       @map("description_ar")
  descriptionEn     String?       @map("description_en")
  /// Optional; a product has at most one brand (TASK-015).
  brandId           String?       @map("brand_id") @db.Uuid
  status            ProductStatus @default(DRAFT)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime      @default(now()) @map("updated_at") @db.Timestamptz(3)
  archivedAt        DateTime?     @map("archived_at") @db.Timestamptz(3)
  /// Set by the first publish, never cleared; locks the slug (TASK-017, ADR-0022).
  firstPublishedAt  DateTime?     @map("first_published_at") @db.Timestamptz(3)
  /// Low-stock alert default for all its variants; a variant may override it
  /// (Q21, TASK-019, ADR-0024). Null: no alert.
  lowStockThreshold Int?          @map("low_stock_threshold")

  brand      Brand?            @relation(fields: [brandId], references: [id], onDelete: Restrict)
  variants   ProductVariant[]
  categories ProductCategory[]
  media      ProductMedia[]
  orderItems OrderItem[]
  discounts  DiscountProduct[]
  reviews    Review[]

  @@index([status, createdAt(sort: Desc)])
  @@index([brandId])
  @@map("products")
}

/// The canonical sellable unit (C6): SKU, and later price, cost and stock,
/// live here. Every product has exactly one default variant. Never
/// hard-deleted: archived instead.
model ProductVariant {
  id                  String               @id @default(uuid(7)) @db.Uuid
  productId           String               @map("product_id") @db.Uuid
  /// Unique across all variants, archived ones included; stored uppercase.
  sku                 String               @unique
  isDefault           Boolean              @default(false) @map("is_default")
  /// Null for a variant without visible options (a simple product).
  variantNameAr       String?              @map("variant_name_ar")
  variantNameEn       String?              @map("variant_name_en")
  /// Option values such as {"shade": "Rose", "size": "50 ml"}.
  attributesJson      Json?                @map("attributes_json")
  status              ProductVariantStatus @default(ACTIVE)
  /// Prices and costs in piastres (TASK-018, ADR-0023). Selling price is
  /// tax-inclusive (C1), positive, null until set; a published product's
  /// active variants all have one (enforced by the service).
  sellingPrice        BigInt?              @map("selling_price")
  /// Unit cost of the latest goods receipt, for display and margin warnings (Q103).
  latestPurchaseCost  BigInt?              @map("latest_purchase_cost")
  /// Inventory valuation and COGS basis (Q103).
  weightedAverageCost BigInt?              @map("weighted_average_cost")
  currency            String               @default("EGP") @db.Char(3)
  /// Set by the first goods receipt (TASK-023); from then on costs change only
  /// through purchasing, never by hand (ADR-0023 §4 item 4).
  firstGoodsReceiptAt DateTime?            @map("first_goods_receipt_at") @db.Timestamptz(3)
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime             @default(now()) @map("updated_at") @db.Timestamptz(3)
  archivedAt          DateTime?            @map("archived_at") @db.Timestamptz(3)
  /// Overrides the product's low-stock threshold (TASK-019, ADR-0024).
  lowStockThreshold   Int?                 @map("low_stock_threshold")

  product               Product                @relation(fields: [productId], references: [id], onDelete: Restrict)
  media                 ProductMedia[]
  inventoryBalance      InventoryBalance?
  inventoryMovements    InventoryMovement[]
  inventoryReservations InventoryReservation[]
  purchaseItems         PurchaseItem[]
  supplierReturnItems   SupplierReturnItem[]
  cartItems             CartItem[]
  orderItems            OrderItem[]

  @@unique([productId], map: "product_variants_one_default_key", where: raw("is_default"))
  @@index([productId, createdAt])
  @@map("product_variants")
}

// ---------------------------------------------------------------------------
// Brands and categories (TASK-015, DB design §5, ADR-0020)
// ---------------------------------------------------------------------------

enum TaxonomyStatus {
  ACTIVE
  INACTIVE

  @@map("taxonomy_status")
}

model Brand {
  id            String         @id @default(uuid(7)) @db.Uuid
  nameAr        String         @map("name_ar")
  nameEn        String         @map("name_en")
  /// Unique, lowercase Latin letters, digits and hyphens.
  slug          String         @unique
  descriptionAr String?        @map("description_ar")
  descriptionEn String?        @map("description_en")
  status        TaxonomyStatus @default(ACTIVE)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime       @default(now()) @map("updated_at") @db.Timestamptz(3)

  products  Product[]
  discounts DiscountBrand[]

  @@index([status, nameEn])
  @@map("brands")
}

model Category {
  id        String         @id @default(uuid(7)) @db.Uuid
  nameAr    String         @map("name_ar")
  nameEn    String         @map("name_en")
  /// Lowercase Latin letters, digits and hyphens; unique among siblings.
  slug      String
  /// Null for a top-level category.
  parentId  String?        @map("parent_id") @db.Uuid
  status    TaxonomyStatus @default(ACTIVE)
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime       @default(now()) @map("updated_at") @db.Timestamptz(3)

  parent    Category?          @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children  Category[]         @relation("CategoryTree")
  products  ProductCategory[]
  discounts DiscountCategory[]

  @@unique([slug], map: "categories_top_level_slug_key", where: raw("parent_id IS NULL"))
  @@unique([parentId, slug], map: "categories_parent_slug_key", where: raw("parent_id IS NOT NULL"))
  @@index([parentId])
  @@map("categories")
}

/// Which categories a product is listed in (many-to-many).
model ProductCategory {
  productId  String   @map("product_id") @db.Uuid
  categoryId String   @map("category_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  product  Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@id([productId, categoryId])
  @@index([categoryId])
  @@map("product_categories")
}

// ---------------------------------------------------------------------------
// Media storage and product media (DB design §5 "product_media", §6
// "media_assets"; Business Spec Q175-Q178; TASK-016, ADR-0021)
// ---------------------------------------------------------------------------

/// Result of the security checks on an uploaded file (DB design §6).
enum MediaScanStatus {
  PENDING
  SAFE
  REJECTED

  @@map("media_scan_status")
}

/// What an upload is for; it decides who may upload and see the file.
enum MediaPurpose {
  PRODUCT_MEDIA
  /// A supplier invoice image (TASK-023, Q117).
  SUPPLIER_INVOICE

  @@map("media_purpose")
}

/// One uploaded file (API §28). The bytes live in file storage, never in
/// PostgreSQL. A row is created when an upload starts (PENDING) and becomes
/// SAFE or REJECTED when it is completed. Never hard-deleted.
model MediaAsset {
  id                  String          @id @default(uuid(7)) @db.Uuid
  /// Which storage holds the bytes, e.g. LOCAL (ADR-0021).
  storageProvider     String          @map("storage_provider")
  /// Generated by the server; never derived from the uploaded file name.
  objectKey           String          @unique @map("object_key")
  originalFilename    String          @map("original_filename")
  /// Declared when the upload starts; confirmed from the file's content.
  mimeType            String          @map("mime_type")
  /// Declared when the upload starts; the actual size once completed.
  sizeBytes           Int             @map("size_bytes")
  width               Int?
  height              Int?
  /// SHA-256 of the file (hex), set when completed.
  checksum            String?
  scanStatus          MediaScanStatus @default(PENDING) @map("scan_status")
  purpose             MediaPurpose
  /// Why the file was refused (an issue code such as file_type_mismatch).
  rejectionReason     String?         @map("rejection_reason")
  /// SHA-256 of the single-use upload token; cleared once the upload is completed.
  uploadTokenHash     String?         @unique @map("upload_token_hash")
  uploadExpiresAt     DateTime        @map("upload_expires_at") @db.Timestamptz(3)
  /// When the bytes were last received.
  uploadedAt          DateTime?       @map("uploaded_at") @db.Timestamptz(3)
  completedAt         DateTime?       @map("completed_at") @db.Timestamptz(3)
  createdByEmployeeId String?         @map("created_by_employee_id") @db.Uuid
  createdAt           DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  createdBy        Employee?         @relation("MediaAssetCreatedBy", fields: [createdByEmployeeId], references: [id], onDelete: Restrict)
  productMedia     ProductMedia[]
  purchaseInvoices PurchaseInvoice[]

  @@index([createdByEmployeeId, createdAt])
  @@map("media_assets")
}

/// An image shown on a product, optionally for one variant (DB design §5).
/// Removing it sets `removed_at`; the row and the file are kept for history.
model ProductMedia {
  id           String    @id @default(uuid(7)) @db.Uuid
  productId    String    @map("product_id") @db.Uuid
  /// Null for an image of the whole product.
  variantId    String?   @map("variant_id") @db.Uuid
  mediaAssetId String    @map("media_asset_id") @db.Uuid
  /// 0-based position among the product's images that are not removed.
  sortOrder    Int       @map("sort_order")
  isMain       Boolean   @default(false) @map("is_main")
  altTextAr    String?   @map("alt_text_ar")
  altTextEn    String?   @map("alt_text_en")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)
  removedAt    DateTime? @map("removed_at") @db.Timestamptz(3)

  product    Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant    ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Restrict)
  mediaAsset MediaAsset      @relation(fields: [mediaAssetId], references: [id], onDelete: Restrict)

  @@unique([productId], map: "product_media_one_main_key", where: raw("is_main AND removed_at IS NULL"))
  @@unique([productId, mediaAssetId], map: "product_media_asset_once_key", where: raw("removed_at IS NULL"))
  @@index([productId, sortOrder])
  @@index([mediaAssetId])
  @@index([variantId])
  @@map("product_media")
}

// ---------------------------------------------------------------------------
// Inventory (TASK-019, DB design §10, ADR-0024). Ledger-driven: a balance
// changes only through an inventory movement, applied by a database trigger.
// ---------------------------------------------------------------------------

/// Stock of one variant (Q109). Created with the variant by a trigger; only
/// inventory movements change it; no quantity goes below zero.
model InventoryBalance {
  productVariantId  String   @id @map("product_variant_id") @db.Uuid
  /// Sellable stock.
  availableQuantity Int      @default(0) @map("available_quantity")
  /// Held for orders (TASK-020); not sellable.
  reservedQuantity  Int      @default(0) @map("reserved_quantity")
  /// Damaged / non-sellable.
  damagedQuantity   Int      @default(0) @map("damaged_quantity")
  updatedAt         DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)

  variant ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Restrict)

  @@map("inventory_balances")
}

/// Why stock changed (Q108). Later tasks add theirs (purchase receipt,
/// reservation, returns, ...).
enum InventoryMovementType {
  /// Available stock corrected by hand, up or down (Q71, Q72).
  MANUAL_ADJUSTMENT
  /// Available stock found damaged: moved to Damaged.
  DAMAGE
  /// Damaged stock written off.
  DAMAGE_WRITE_OFF
  /// Available held for an order: Available → Reserved (TASK-020, Q9, Q28).
  RESERVATION
  /// An order's hold given back: Reserved → Available (cancelled/expired).
  RELEASE_RESERVATION
  /// An order's hold consumed at Shipped: Reserved out (ADR-0025).
  CUSTOMER_ORDER_COMMIT
  /// Goods received from a supplier (TASK-023, Q104): accepted units into
  /// Available, damaged ones into Damaged, with the purchase unit cost.
  PURCHASE_RECEIPT
  /// Damaged units sent back to the supplier (TASK-024, Q105): Damaged out.
  SUPPLIER_RETURN

  @@map("inventory_movement_type")
}

/// The inventory ledger (Q108): append-only; inserting a row applies its
/// deltas to the variant's balance.
model InventoryMovement {
  id               String                @id @default(uuid(7)) @db.Uuid
  productVariantId String                @map("product_variant_id") @db.Uuid
  movementType     InventoryMovementType @map("movement_type")
  availableDelta   Int                   @default(0) @map("available_delta")
  reservedDelta    Int                   @default(0) @map("reserved_delta")
  damagedDelta     Int                   @default(0) @map("damaged_delta")
  /// The business record behind the movement (goods receipt, order, ...).
  referenceType    String?               @map("reference_type")
  referenceId      String?               @map("reference_id") @db.Uuid
  /// Piastres per unit, for movements that bring stock in (TASK-023).
  unitCost         BigInt?               @map("unit_cost")
  reason           String?
  createdByType    AuditActorType        @map("created_by_type")
  createdById      String?               @map("created_by_id") @db.Uuid
  createdAt        DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)

  variant ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Restrict)

  @@index([productVariantId, createdAt(sort: Desc)])
  @@map("inventory_movements")
}

enum InventoryReservationStatus {
  /// Holding stock in Reserved.
  ACTIVE
  /// Given back to Available (order cancelled or expired).
  RELEASED
  /// Consumed when the order shipped.
  CONVERTED

  @@map("inventory_reservation_status")
}

/// Stock held for an order (TASK-020, DB design §10, ADR-0025). Every status
/// change writes its inventory movement in the same transaction.
model InventoryReservation {
  id               String                     @id @default(uuid(7)) @db.Uuid
  orderId          String                     @map("order_id") @db.Uuid
  productVariantId String                     @map("product_variant_id") @db.Uuid
  quantity         Int
  status           InventoryReservationStatus @default(ACTIVE)
  reservedAt       DateTime                   @map("reserved_at") @db.Timestamptz(3)
  releasedAt       DateTime?                  @map("released_at") @db.Timestamptz(3)
  convertedAt      DateTime?                  @map("converted_at") @db.Timestamptz(3)

  variant ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Restrict)
  order   Order          @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@unique([orderId, productVariantId], map: "inventory_reservations_one_active_key", where: raw("status = 'ACTIVE'"))
  @@index([productVariantId, status])
  @@index([orderId])
  @@map("inventory_reservations")
}

// ---------------------------------------------------------------------------
// Suppliers (TASK-021, DB design §11, ADR-0026)
// ---------------------------------------------------------------------------

enum SupplierStatus {
  ACTIVE
  /// No new purchase orders (TASK-022); history and links stay.
  INACTIVE

  @@map("supplier_status")
}

/// A supplier the store buys from. Never deleted (purchases, invoices and the
/// supplier ledger point at it); deactivated instead.
model Supplier {
  id        String         @id @default(uuid(7)) @db.Uuid
  name      String
  phone     String?
  email     String?
  address   String?
  notes     String?
  status    SupplierStatus @default(ACTIVE)
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime       @default(now()) @map("updated_at") @db.Timestamptz(3)

  purchaseOrders PurchaseOrder[]
  returns        SupplierReturn[]
  payments       SupplierPayment[]
  ledgerEntries  SupplierLedgerEntry[]

  @@index([status, name])
  @@map("suppliers")
}

// ---------------------------------------------------------------------------
// Purchase orders (TASK-022, DB design §11, ADR-0027)
// ---------------------------------------------------------------------------

enum PurchaseOrderStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  SENT
  /// Set by goods receiving (TASK-023).
  PARTIALLY_RECEIVED
  RECEIVED
  CLOSED
  CANCELLED

  @@map("purchase_order_status")
}

/// An order to a supplier. Never deleted; it never changes stock (Q101):
/// stock enters through goods receipts (TASK-023).
model PurchaseOrder {
  id                    String              @id @default(uuid(7)) @db.Uuid
  /// "PO-000001", from the sequence `purchase_order_number_seq`.
  purchaseNumber        String              @unique @default(dbgenerated("('PO-'::text || lpad((nextval('purchase_order_number_seq'::regclass))::text, 6, '0'::text))")) @map("purchase_number")
  supplierId            String              @map("supplier_id") @db.Uuid
  status                PurchaseOrderStatus @default(DRAFT)
  /// Sum of the line totals, in piastres.
  orderedTotal          BigInt              @map("ordered_total")
  currency              String              @default("EGP") @db.Char(3)
  notes                 String?
  createdByEmployeeId   String              @map("created_by_employee_id") @db.Uuid
  submittedAt           DateTime?           @map("submitted_at") @db.Timestamptz(3)
  approvedByEmployeeId  String?             @map("approved_by_employee_id") @db.Uuid
  approvedAt            DateTime?           @map("approved_at") @db.Timestamptz(3)
  sentAt                DateTime?           @map("sent_at") @db.Timestamptz(3)
  cancelledByEmployeeId String?             @map("cancelled_by_employee_id") @db.Uuid
  cancelledAt           DateTime?           @map("cancelled_at") @db.Timestamptz(3)
  cancellationReason    String?             @map("cancellation_reason")
  /// Closed by hand once nothing more will be received (TASK-023).
  closedByEmployeeId    String?             @map("closed_by_employee_id") @db.Uuid
  closedAt              DateTime?           @map("closed_at") @db.Timestamptz(3)
  closingReason         String?             @map("closing_reason")
  createdAt             DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime            @default(now()) @map("updated_at") @db.Timestamptz(3)

  supplier    Supplier              @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  createdBy   Employee              @relation("PurchaseOrderCreatedBy", fields: [createdByEmployeeId], references: [id], onDelete: Restrict)
  approvedBy  Employee?             @relation("PurchaseOrderApprovedBy", fields: [approvedByEmployeeId], references: [id], onDelete: Restrict)
  cancelledBy Employee?             @relation("PurchaseOrderCancelledBy", fields: [cancelledByEmployeeId], references: [id], onDelete: Restrict)
  closedBy    Employee?             @relation("PurchaseOrderClosedBy", fields: [closedByEmployeeId], references: [id], onDelete: Restrict)
  items       PurchaseItem[]
  receipts    GoodsReceipt[]
  invoices    PurchaseInvoice[]
  returns     SupplierReturn[]
  payments    SupplierPayment[]
  ledger      SupplierLedgerEntry[]

  @@index([status, createdAt])
  @@index([supplierId, createdAt])
  @@map("purchase_orders")
}

/// One variant on a purchase order, with its own unit cost (Q102). Lines
/// change only while the order is a draft (trigger).
model PurchaseItem {
  id               String @id @default(uuid(7)) @db.Uuid
  purchaseOrderId  String @map("purchase_order_id") @db.Uuid
  productVariantId String @map("product_variant_id") @db.Uuid
  orderedQuantity  Int    @map("ordered_quantity")
  /// Piastres per unit.
  unitCost         BigInt @map("unit_cost")
  /// ordered_quantity × unit_cost.
  lineTotal        BigInt @map("line_total")

  purchaseOrder PurchaseOrder        @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  variant       ProductVariant       @relation(fields: [productVariantId], references: [id], onDelete: Restrict)
  receiptItems  GoodsReceiptItem[]
  returnItems   SupplierReturnItem[]

  @@unique([purchaseOrderId, productVariantId])
  @@index([productVariantId])
  @@map("purchase_items")
}

// ---------------------------------------------------------------------------
// Goods receipts and supplier invoices (TASK-023, DB design §11, ADR-0028).
// Both are append-only: the database rejects UPDATE and DELETE.
// ---------------------------------------------------------------------------

/// One delivery received and inspected against a purchase order (Q101,
/// Q104, Q114-Q116). Recording it changes stock at once (one step, ADR-0028).
model GoodsReceipt {
  id                   String   @id @default(uuid(7)) @db.Uuid
  /// "GR-000001", from the sequence `goods_receipt_number_seq`.
  receiptNumber        String   @unique @default(dbgenerated("('GR-'::text || lpad((nextval('goods_receipt_number_seq'::regclass))::text, 6, '0'::text))")) @map("receipt_number")
  purchaseOrderId      String   @map("purchase_order_id") @db.Uuid
  receivedByEmployeeId String   @map("received_by_employee_id") @db.Uuid
  receivedAt           DateTime @map("received_at") @db.Timestamptz(3)
  notes                String?

  purchaseOrder PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  receivedBy    Employee           @relation("GoodsReceiptReceivedBy", fields: [receivedByEmployeeId], references: [id], onDelete: Restrict)
  items         GoodsReceiptItem[]

  @@index([purchaseOrderId, receivedAt])
  @@map("goods_receipts")
}

/// One purchase line in a delivery. delivered = accepted + damaged +
/// over-delivery; the extras wait for a PURCHASE_OVER_DELIVERY approval.
model GoodsReceiptItem {
  id                   String  @id @default(uuid(7)) @db.Uuid
  goodsReceiptId       String  @map("goods_receipt_id") @db.Uuid
  purchaseItemId       String  @map("purchase_item_id") @db.Uuid
  deliveredQuantity    Int     @map("delivered_quantity")
  /// Into Available stock.
  acceptedQuantity     Int     @map("accepted_quantity")
  /// Into Damaged stock (Q104, Q109); counts against the ordered quantity.
  damagedQuantity      Int     @map("damaged_quantity")
  /// Beyond the ordered quantity; enters stock only once approved (Q116).
  overDeliveryQuantity Int     @map("over_delivery_quantity")
  inspectionNotes      String? @map("inspection_notes")

  goodsReceipt GoodsReceipt         @relation(fields: [goodsReceiptId], references: [id], onDelete: Restrict)
  purchaseItem PurchaseItem         @relation(fields: [purchaseItemId], references: [id], onDelete: Restrict)
  returnItems  SupplierReturnItem[]

  @@unique([goodsReceiptId, purchaseItemId])
  @@index([purchaseItemId])
  @@map("goods_receipt_items")
}

/// A supplier invoice as issued (Q115, Q117): never edited to match what was
/// received; discrepancies live on the goods receipts.
model PurchaseInvoice {
  id                   String   @id @default(uuid(7)) @db.Uuid
  purchaseOrderId      String   @map("purchase_order_id") @db.Uuid
  /// The supplier's own number.
  invoiceNumber        String   @map("invoice_number")
  invoiceDate          DateTime @map("invoice_date") @db.Date
  /// Piastres, as on the invoice (tax included).
  invoiceTotal         BigInt   @map("invoice_total")
  taxAmount            BigInt?  @map("tax_amount")
  /// The uploaded invoice file (purpose SUPPLIER_INVOICE).
  mediaAssetId         String   @unique @map("media_asset_id") @db.Uuid
  notes                String?
  recordedByEmployeeId String   @map("recorded_by_employee_id") @db.Uuid
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  purchaseOrder PurchaseOrder        @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  mediaAsset    MediaAsset           @relation(fields: [mediaAssetId], references: [id], onDelete: Restrict)
  recordedBy    Employee             @relation("PurchaseInvoiceRecordedBy", fields: [recordedByEmployeeId], references: [id], onDelete: Restrict)
  ledgerEntry   SupplierLedgerEntry?

  @@unique([purchaseOrderId, invoiceNumber])
  @@map("purchase_invoices")
}

// ---------------------------------------------------------------------------
// Supplier returns, payments and ledger (TASK-024, DB design §11 and v1.1,
// ADR-0029). Return lines, payments and ledger entries are append-only.
// ---------------------------------------------------------------------------

enum SupplierReturnStatus {
  DRAFT
  /// Waiting for Owner/Admin review (Q105).
  PENDING_APPROVAL
  /// Approved: the units left Damaged stock and went back to the supplier.
  APPROVED
  /// Final; the units may go on a new return.
  REJECTED
  /// Refund, credit or other settlement recorded (Q107).
  SETTLED

  @@map("supplier_return_status")
}

enum SupplierReturnResolution {
  REFUND
  CREDIT
  /// No money (e.g. replacement goods); described in the notes.
  OTHER

  @@map("supplier_return_resolution")
}

/// Damaged units of a purchase order sent back to its supplier (Q105, Q106,
/// Q107, Q120). Never deleted.
model SupplierReturn {
  id                   String                    @id @default(uuid(7)) @db.Uuid
  /// "SR-000001", from the sequence `supplier_return_number_seq`.
  returnNumber         String                    @unique @default(dbgenerated("('SR-'::text || lpad((nextval('supplier_return_number_seq'::regclass))::text, 6, '0'::text))")) @map("return_number")
  supplierId           String                    @map("supplier_id") @db.Uuid
  purchaseOrderId      String                    @map("purchase_order_id") @db.Uuid
  status               SupplierReturnStatus      @default(DRAFT)
  reason               String
  /// Σ quantity × purchase unit cost, in piastres (Q120).
  expectedAmount       BigInt                    @map("expected_amount")
  financialResolution  SupplierReturnResolution? @map("financial_resolution")
  /// Piastres settled; 0 for OTHER.
  financialAmount      BigInt?                   @map("financial_amount")
  settlementNotes      String?                   @map("settlement_notes")
  createdByEmployeeId  String                    @map("created_by_employee_id") @db.Uuid
  submittedAt          DateTime?                 @map("submitted_at") @db.Timestamptz(3)
  approvedByEmployeeId String?                   @map("approved_by_employee_id") @db.Uuid
  approvedAt           DateTime?                 @map("approved_at") @db.Timestamptz(3)
  settledByEmployeeId  String?                   @map("settled_by_employee_id") @db.Uuid
  settledAt            DateTime?                 @map("settled_at") @db.Timestamptz(3)
  createdAt            DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime                  @default(now()) @map("updated_at") @db.Timestamptz(3)

  supplier      Supplier              @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  purchaseOrder PurchaseOrder         @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  createdBy     Employee              @relation("SupplierReturnCreatedBy", fields: [createdByEmployeeId], references: [id], onDelete: Restrict)
  approvedBy    Employee?             @relation("SupplierReturnApprovedBy", fields: [approvedByEmployeeId], references: [id], onDelete: Restrict)
  settledBy     Employee?             @relation("SupplierReturnSettledBy", fields: [settledByEmployeeId], references: [id], onDelete: Restrict)
  items         SupplierReturnItem[]
  ledgerEntries SupplierLedgerEntry[]

  @@index([purchaseOrderId, createdAt])
  @@index([supplierId, createdAt])
  @@index([status, createdAt])
  @@map("supplier_returns")
}

/// Damaged units of one goods receipt line being returned.
model SupplierReturnItem {
  id                 String  @id @default(uuid(7)) @db.Uuid
  supplierReturnId   String  @map("supplier_return_id") @db.Uuid
  goodsReceiptItemId String  @map("goods_receipt_item_id") @db.Uuid
  purchaseItemId     String  @map("purchase_item_id") @db.Uuid
  productVariantId   String  @map("product_variant_id") @db.Uuid
  quantity           Int
  /// The purchase line's unit cost, in piastres.
  unitCost           BigInt  @map("unit_cost")
  reason             String?

  supplierReturn   SupplierReturn   @relation(fields: [supplierReturnId], references: [id], onDelete: Restrict)
  goodsReceiptItem GoodsReceiptItem @relation(fields: [goodsReceiptItemId], references: [id], onDelete: Restrict)
  purchaseItem     PurchaseItem     @relation(fields: [purchaseItemId], references: [id], onDelete: Restrict)
  variant          ProductVariant   @relation(fields: [productVariantId], references: [id], onDelete: Restrict)

  @@unique([supplierReturnId, goodsReceiptItemId])
  @@index([goodsReceiptItemId])
  @@map("supplier_return_items")
}

enum SupplierPaymentMethod {
  CASH
  BANK_TRANSFER
  CHEQUE
  OTHER

  @@map("supplier_payment_method")
}

/// Money paid to a supplier (API v1.1 "Supplier finance"). Its ledger entry
/// lowers what we owe.
model SupplierPayment {
  id                   String                @id @default(uuid(7)) @db.Uuid
  supplierId           String                @map("supplier_id") @db.Uuid
  /// The purchase order paid for, when there is one (Q118).
  purchaseOrderId      String?               @map("purchase_order_id") @db.Uuid
  /// Piastres.
  amount               BigInt
  method               SupplierPaymentMethod
  paidOn               DateTime              @map("paid_on") @db.Date
  reference            String?
  notes                String?
  recordedByEmployeeId String                @map("recorded_by_employee_id") @db.Uuid
  createdAt            DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)

  supplier      Supplier             @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  purchaseOrder PurchaseOrder?       @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  recordedBy    Employee             @relation("SupplierPaymentRecordedBy", fields: [recordedByEmployeeId], references: [id], onDelete: Restrict)
  ledgerEntry   SupplierLedgerEntry?

  @@index([supplierId, createdAt])
  @@map("supplier_payments")
}

enum SupplierLedgerEntryType {
  INVOICE
  PAYMENT
  /// Supplier credit for returned goods.
  CREDIT
  /// Cash received back from the supplier.
  REFUND
  /// Not created in v1 (ADR-0029).
  ADJUSTMENT

  @@map("supplier_ledger_entry_type")
}

/// The supplier's account: CREDIT raises what we owe, DEBIT lowers it.
enum SupplierLedgerDirection {
  CREDIT
  DEBIT

  @@map("supplier_ledger_direction")
}

/// Supplier payable history (Audit Correction 6, Q119). The balance (what we
/// owe) is Σ CREDIT − Σ DEBIT.
model SupplierLedgerEntry {
  id                  String                  @id @default(uuid(7)) @db.Uuid
  supplierId          String                  @map("supplier_id") @db.Uuid
  purchaseOrderId     String?                 @map("purchase_order_id") @db.Uuid
  supplierReturnId    String?                 @map("supplier_return_id") @db.Uuid
  purchaseInvoiceId   String?                 @unique @map("purchase_invoice_id") @db.Uuid
  supplierPaymentId   String?                 @unique @map("supplier_payment_id") @db.Uuid
  entryType           SupplierLedgerEntryType @map("entry_type")
  direction           SupplierLedgerDirection
  /// Piastres, > 0; the direction gives the sign.
  amount              BigInt
  /// Invoice number, return number or payment reference.
  reference           String?
  createdByEmployeeId String                  @map("created_by_employee_id") @db.Uuid
  createdAt           DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)

  supplier        Supplier         @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  purchaseOrder   PurchaseOrder?   @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  supplierReturn  SupplierReturn?  @relation(fields: [supplierReturnId], references: [id], onDelete: Restrict)
  purchaseInvoice PurchaseInvoice? @relation(fields: [purchaseInvoiceId], references: [id], onDelete: Restrict)
  supplierPayment SupplierPayment? @relation(fields: [supplierPaymentId], references: [id], onDelete: Restrict)
  createdBy       Employee         @relation("SupplierLedgerEntryCreatedBy", fields: [createdByEmployeeId], references: [id], onDelete: Restrict)

  @@unique([supplierReturnId, entryType])
  @@index([supplierId, createdAt])
  @@index([purchaseOrderId])
  @@map("supplier_ledger_entries")
}

// ---------------------------------------------------------------------------
// Locations and customer addresses (TASK-009, Business Spec R32, ADR-0030)

enum LocationStatus {
  ACTIVE
  INACTIVE

  @@map("location_status")
}

/// The 27 Egyptian governorates, preloaded by the migration. Never deleted.
model Governorate {
  id        String         @id @default(uuid(7)) @db.Uuid
  /// ISO 3166-2:EG subdivision code without the "EG-" prefix, e.g. "C", "ALX".
  code      String         @unique
  nameAr    String         @map("name_ar")
  nameEn    String         @map("name_en")
  status    LocationStatus @default(ACTIVE)
  sortOrder Int            @map("sort_order")
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime       @default(now()) @map("updated_at") @db.Timestamptz(3)

  areas         Area[]
  shippingRules ShippingRule[]

  @@map("governorates")
}

/// An area of a governorate, added by the Owner/Admin (R32). Never deleted.
model Area {
  id            String         @id @default(uuid(7)) @db.Uuid
  governorateId String         @map("governorate_id") @db.Uuid
  nameAr        String         @map("name_ar")
  nameEn        String         @map("name_en")
  status        LocationStatus @default(ACTIVE)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime       @default(now()) @map("updated_at") @db.Timestamptz(3)

  governorate   Governorate       @relation(fields: [governorateId], references: [id], onDelete: Restrict)
  addresses     CustomerAddress[]
  shippingRules ShippingRule[]

  @@unique([governorateId, nameAr])
  @@unique([governorateId, nameEn])
  @@map("areas")
}

/// A saved delivery address (DB design §3.3). Orders copy it into a snapshot
/// (Q46), so nothing references an address and it can be deleted.
model CustomerAddress {
  id            String   @id @default(uuid(7)) @db.Uuid
  customerId    String   @map("customer_id") @db.Uuid
  label         String?
  recipientName String   @map("recipient_name")
  /// Egyptian mobile in E.164 (R27).
  phone         String
  /// The governorate is the area's governorate (R32).
  areaId        String   @map("area_id") @db.Uuid
  city          String?
  street        String
  building      String?
  floor         String?
  apartment     String?
  landmark      String?
  notes         String?
  isDefault     Boolean  @default(false) @map("is_default")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  area     Area     @relation(fields: [areaId], references: [id], onDelete: Restrict)

  @@unique([customerId], map: "customer_addresses_one_default_key", where: raw("is_default"))
  @@index([customerId, createdAt])
  @@index([areaId])
  @@map("customer_addresses")
}

// ---------------------------------------------------------------------------
// Cart (TASK-025, DB design §7, ADR-0031). Informational only: checkout
// revalidates every price, stock level and discount.
// ---------------------------------------------------------------------------

enum CartStatus {
  ACTIVE
  /// Turned into an order (TASK-029).
  CONVERTED
  ABANDONED
  EXPIRED
  /// A guest cart merged into a customer cart after login (R33).
  MERGED

  @@map("cart_status")
}

/// A guest cart (identified by the SHA-256 of its token) or a customer cart.
/// A customer has at most one ACTIVE cart.
model Cart {
  id             String     @id @default(uuid(7)) @db.Uuid
  customerId     String?    @map("customer_id") @db.Uuid
  /// SHA-256 (hex) of the guest cart token; null for a customer cart.
  guestTokenHash String?    @unique @map("guest_token_hash")
  status         CartStatus @default(ACTIVE)
  currency       String     @default("EGP") @db.Char(3)
  /// The discount the shopper chose (Q138); rechecked on every read (TASK-026).
  discountId     String?    @map("discount_id") @db.Uuid
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime   @default(now()) @map("updated_at") @db.Timestamptz(3)

  customer         Customer?         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  discount         Discount?         @relation(fields: [discountId], references: [id], onDelete: Restrict)
  items            CartItem[]
  checkoutAttempts CheckoutAttempt[]

  @@unique([customerId], map: "carts_one_active_per_customer_key", where: raw("status = 'ACTIVE'"))
  @@map("carts")
}

/// One variant in a cart. `lastSeenUnitPrice` is the price the shopper last
/// saw (Q37): a different current price asks for review.
model CartItem {
  id                String   @id @default(uuid(7)) @db.Uuid
  cartId            String   @map("cart_id") @db.Uuid
  productVariantId  String   @map("product_variant_id") @db.Uuid
  quantity          Int
  /// Piastres.
  lastSeenUnitPrice BigInt   @map("last_seen_unit_price")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Restrict)

  @@unique([cartId, productVariantId])
  @@index([productVariantId])
  @@map("cart_items")
}

// ---------------------------------------------------------------------------
// Discounts (TASK-026, DB design §14, Business Spec Q125, Q131–Q138, R36,
// ADR-0032). Never deleted: deactivated instead.
// ---------------------------------------------------------------------------

enum DiscountStatus {
  ACTIVE
  INACTIVE

  @@map("discount_status")
}

enum DiscountType {
  PERCENTAGE

  @@map("discount_type")
}

enum DiscountScope {
  /// Every purchasable item.
  STORE_WIDE
  /// Items whose product, category (or a subcategory of it) or brand is linked.
  TARGETED

  @@map("discount_scope")
}

model Discount {
  id                    String         @id @default(uuid(7)) @db.Uuid
  /// Stored uppercase; unique. Null: an offer shown in the cart without a code.
  code                  String?        @unique
  nameAr                String         @map("name_ar")
  nameEn                String         @map("name_en")
  discountType          DiscountType   @default(PERCENTAGE) @map("discount_type")
  /// Whole percent, 1–100 (not money).
  value                 Int
  scope                 DiscountScope
  /// Piastres; caps the discount of one order.
  maxDiscountAmount     BigInt?        @map("max_discount_amount")
  /// Piastres; compared with the whole cart subtotal.
  minimumOrderTotal     BigInt?        @map("minimum_order_total")
  startsAt              DateTime       @map("starts_at") @db.Timestamptz(3)
  /// Null: no end.
  endsAt                DateTime?      @map("ends_at") @db.Timestamptz(3)
  usageLimitTotal       Int?           @map("usage_limit_total")
  usageLimitPerCustomer Int?           @map("usage_limit_per_customer")
  status                DiscountStatus @default(INACTIVE)
  createdByEmployeeId   String         @map("created_by_employee_id") @db.Uuid
  createdAt             DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime       @default(now()) @map("updated_at") @db.Timestamptz(3)

  createdBy  Employee           @relation("DiscountCreatedBy", fields: [createdByEmployeeId], references: [id], onDelete: Restrict)
  products   DiscountProduct[]
  categories DiscountCategory[]
  brands     DiscountBrand[]
  usages     DiscountUsage[]
  carts      Cart[]
  orders     Order[]

  @@index([status, startsAt])
  @@map("discounts")
}

model DiscountProduct {
  discountId String @map("discount_id") @db.Uuid
  productId  String @map("product_id") @db.Uuid

  discount Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@id([discountId, productId])
  @@index([productId])
  @@map("discount_products")
}

model DiscountCategory {
  discountId String @map("discount_id") @db.Uuid
  categoryId String @map("category_id") @db.Uuid

  discount Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@id([discountId, categoryId])
  @@index([categoryId])
  @@map("discount_categories")
}

model DiscountBrand {
  discountId String @map("discount_id") @db.Uuid
  brandId    String @map("brand_id") @db.Uuid

  discount Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)
  brand    Brand    @relation(fields: [brandId], references: [id], onDelete: Restrict)

  @@id([discountId, brandId])
  @@index([brandId])
  @@map("discount_brands")
}

/// One use of a discount by an order (R36): counted from order creation,
/// given back (`released_at`) when the order is cancelled or expires before
/// shipping. TASK-030 adds the foreign key to `orders`.
model DiscountUsage {
  id             String    @id @default(uuid(7)) @db.Uuid
  discountId     String    @map("discount_id") @db.Uuid
  customerId     String?   @map("customer_id") @db.Uuid
  orderId        String    @unique @map("order_id") @db.Uuid
  /// Piastres.
  discountAmount BigInt    @map("discount_amount")
  usedAt         DateTime  @map("used_at") @db.Timestamptz(3)
  releasedAt     DateTime? @map("released_at") @db.Timestamptz(3)

  discount Discount  @relation(fields: [discountId], references: [id], onDelete: Restrict)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: Restrict)
  order    Order     @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([discountId, releasedAt])
  @@index([customerId, discountId])
  @@map("discount_usages")
}

// ---------------------------------------------------------------------------
// Shipping rules (TASK-027, Business Spec Q121–Q126, R37, ADR-0033)

enum ShippingStatus {
  ACTIVE
  INACTIVE

  @@map("shipping_status")
}

/// A contracted shipping company (Q121). Never deleted: deactivated instead.
model ShippingCompany {
  id          String         @id @default(uuid(7)) @db.Uuid
  /// Stored uppercase; unique.
  code        String         @unique
  name        String
  contactInfo String?        @map("contact_info")
  status      ShippingStatus @default(ACTIVE)
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime       @default(now()) @map("updated_at") @db.Timestamptz(3)

  rules  ShippingRule[]
  orders Order[]

  @@map("shipping_companies")
}

/// A shipping fee for a place and order-total band (Q122, R37). The most
/// specific matching rule wins (area, then governorate, then everywhere);
/// `priority` breaks ties. Never deleted: deactivated instead.
model ShippingRule {
  id                String         @id @default(uuid(7)) @db.Uuid
  /// The company proposed for orders this rule prices; null: staff choose.
  shippingCompanyId String?        @map("shipping_company_id") @db.Uuid
  /// Null: everywhere. Set whenever `areaId` is (the area's governorate).
  governorateId     String?        @map("governorate_id") @db.Uuid
  areaId            String?        @map("area_id") @db.Uuid
  /// Piastres, inclusive; compared with the total after discounts.
  minOrderTotal     BigInt?        @map("min_order_total")
  /// Piastres, exclusive.
  maxOrderTotal     BigInt?        @map("max_order_total")
  /// Piastres.
  shippingFee       BigInt         @map("shipping_fee")
  /// Higher wins among equally specific rules.
  priority          Int            @default(0)
  activeFrom        DateTime?      @map("active_from") @db.Timestamptz(3)
  activeTo          DateTime?      @map("active_to") @db.Timestamptz(3)
  status            ShippingStatus @default(ACTIVE)
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime       @default(now()) @map("updated_at") @db.Timestamptz(3)

  shippingCompany ShippingCompany? @relation(fields: [shippingCompanyId], references: [id], onDelete: Restrict)
  governorate     Governorate?     @relation(fields: [governorateId], references: [id], onDelete: Restrict)
  area            Area?            @relation(fields: [areaId], references: [id], onDelete: Restrict)

  @@index([status])
  @@map("shipping_rules")
}

// ---------------------------------------------------------------------------
// Wallet (TASK-028, DB design §13, Business Spec Q26, Q78, Q166–Q170, C4, ADR-0034)

/// Why a wallet balance changed. Later tasks add theirs.
enum WalletTransactionType {
  /// Owner/Admin correction, credit or debit, with a reason (Q78).
  MANUAL_ADJUSTMENT
  /// Wallet funds spent on an order: its reservation captured.
  ORDER_WALLET_USE
  /// A return refunded to the wallet (Q26, Q97, R7; TASK-040).
  RETURN_REFUND

  @@map("wallet_transaction_type")
}

enum WalletDirection {
  CREDIT
  DEBIT

  @@map("wallet_direction")
}

enum WalletReservationStatus {
  /// Held for a pending order; not spendable.
  ACTIVE
  /// Spent: an ORDER_WALLET_USE debit was written.
  CAPTURED
  /// Given back (order cancelled or expired); no ledger entry.
  RELEASED

  @@map("wallet_reservation_status")
}

/// A customer's wallet (Q166–Q170). `balance` is Σ CREDIT − Σ DEBIT of its
/// transactions, kept by the `wallet_transactions_apply` trigger; nothing
/// else may change it, and it never goes below zero.
model Wallet {
  id         String   @id @default(uuid(7)) @db.Uuid
  customerId String   @unique @map("customer_id") @db.Uuid
  currency   String   @default("EGP") @db.Char(3)
  /// Piastres, reserved funds included.
  balance    BigInt   @default(0)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)

  customer     Customer            @relation(fields: [customerId], references: [id], onDelete: Restrict)
  transactions WalletTransaction[]
  reservations WalletReservation[]

  @@map("wallets")
}

/// Append-only wallet ledger (Q170): rows are never updated or deleted.
model WalletTransaction {
  id              String                @id @default(uuid(7)) @db.Uuid
  walletId        String                @map("wallet_id") @db.Uuid
  transactionType WalletTransactionType @map("transaction_type")
  direction       WalletDirection
  /// Piastres, > 0.
  amount          BigInt
  /// What caused it, e.g. ORDER / order id, RETURN / return id.
  referenceType   String?               @map("reference_type")
  referenceId     String?               @map("reference_id") @db.Uuid
  reason          String?
  createdAt       DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Restrict)

  @@index([walletId, createdAt])
  @@index([referenceType, referenceId])
  @@map("wallet_transactions")
}

/// Wallet funds held for a pending order (C4, User Flows §12.2). At most one
/// ACTIVE reservation per order.
model WalletReservation {
  id         String                  @id @default(uuid(7)) @db.Uuid
  walletId   String                  @map("wallet_id") @db.Uuid
  orderId    String                  @map("order_id") @db.Uuid
  /// Piastres, > 0.
  amount     BigInt
  status     WalletReservationStatus @default(ACTIVE)
  createdAt  DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  releasedAt DateTime?               @map("released_at") @db.Timestamptz(3)
  capturedAt DateTime?               @map("captured_at") @db.Timestamptz(3)

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Restrict)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@unique([orderId], map: "wallet_reservations_one_active_key", where: raw("status = 'ACTIVE'"))
  @@index([walletId, status])
  @@index([orderId])
  @@map("wallet_reservations")
}

// ---------------------------------------------------------------------------
// Orders & checkout (TASK-029, DB design §7–§8 and "Order financial fields",
// Business Spec Q28, Q37–Q40, Q46, C1, C4, R36, R37; ADR-0035). TASK-030
// adds the order APIs, status transitions and the remaining foreign keys
// (ADR-0036); commercial snapshots are immutable (trigger `orders_immutable`).
// ---------------------------------------------------------------------------

enum OrderStatus {
  PENDING_CONFIRMATION
  NEW
  CONFIRMED
  PREPARING
  READY_FOR_SHIPMENT
  SHIPPED
  DELIVERED
  CANCELLED
  EXPIRED

  @@map("order_status")
}

/// How the customer confirmed a COD order (R10). SMS is a future value.
enum CodConfirmationSource {
  WHATSAPP
  PHONE

  @@map("cod_confirmation_source")
}

enum PaymentMethod {
  COD

  @@map("payment_method")
}

/// One customer or guest order. Amounts are piastres; snapshots are the
/// historical facts of the order (Q46) and never follow later changes.
model Order {
  id                                  String                 @id @default(uuid(7)) @db.Uuid
  /// Readable, from the `order_number_seq` sequence; never authorizes access.
  orderNumber                         String                 @unique @map("order_number")
  customerId                          String?                @map("customer_id") @db.Uuid
  guestEmail                          String?                @map("guest_email")
  guestPhone                          String?                @map("guest_phone")
  status                              OrderStatus
  paymentMethod                       PaymentMethod          @default(COD) @map("payment_method")
  currency                            String                 @default("EGP") @db.Char(3)
  locale                              Locale
  subtotal                            BigInt
  discountTotal                       BigInt                 @map("discount_total")
  shippingFee                         BigInt                 @map("shipping_fee")
  /// `subtotal - discountTotal + shippingFee`.
  total                               BigInt
  walletAmountReserved                BigInt                 @map("wallet_amount_reserved")
  walletAmountCaptured                BigInt                 @default(0) @map("wallet_amount_captured")
  /// `total - walletAmountReserved`; 0 needs no COD confirmation (C4).
  codAmount                           BigInt                 @map("cod_amount")
  /// Prices are tax-inclusive (C1); amount and rate wait for the tax decision.
  taxIncluded                         Boolean                @default(true) @map("tax_included")
  taxAmount                           BigInt?                @map("tax_amount")
  taxRate                             Decimal?               @map("tax_rate") @db.Decimal(5, 2)
  appliedDiscountId                   String?                @map("applied_discount_id") @db.Uuid
  discountSnapshot                    Json?                  @map("discount_snapshot_json")
  /// The proposed company (R37); staff may change it later.
  shippingCompanyId                   String?                @map("shipping_company_id") @db.Uuid
  shippingRuleSnapshot                Json                   @map("shipping_rule_snapshot_json")
  shippingAddressSnapshot             Json                   @map("shipping_address_snapshot_json")
  customerSnapshot                    Json                   @map("customer_snapshot_json")
  /// Set by `New → Confirmed` (CONFIRM_ORDER, TASK-030).
  confirmedAt                         DateTime?              @map("confirmed_at") @db.Timestamptz(3)
  /// COD confirmation (TASK-031, R1, R10, R39). The deadline is fixed at
  /// creation for PENDING_CONFIRMATION orders; null when no COD is due.
  codConfirmationDeadlineAt           DateTime?              @map("cod_confirmation_deadline_at") @db.Timestamptz(3)
  codConfirmationSource               CodConfirmationSource? @map("cod_confirmation_source")
  codConfirmedAt                      DateTime?              @map("cod_confirmed_at") @db.Timestamptz(3)
  /// Required when the source is PHONE.
  codConfirmationRecordedByEmployeeId String?                @map("cod_confirmation_recorded_by_employee_id") @db.Uuid
  codReminderCount                    Int                    @default(0) @map("cod_reminder_count")
  codLastReminderAt                   DateTime?              @map("cod_last_reminder_at") @db.Timestamptz(3)
  expiredAt                           DateTime?              @map("expired_at") @db.Timestamptz(3)
  createdAt                           DateTime               @map("created_at") @db.Timestamptz(3)
  updatedAt                           DateTime               @map("updated_at") @db.Timestamptz(3)

  customer                  Customer?              @relation(fields: [customerId], references: [id], onDelete: Restrict)
  appliedDiscount           Discount?              @relation(fields: [appliedDiscountId], references: [id], onDelete: Restrict)
  shippingCompany           ShippingCompany?       @relation(fields: [shippingCompanyId], references: [id], onDelete: Restrict)
  codConfirmationRecordedBy Employee?              @relation("OrderCodConfirmationRecordedBy", fields: [codConfirmationRecordedByEmployeeId], references: [id], onDelete: Restrict)
  codConfirmationTokens     CodConfirmationToken[]
  items                     OrderItem[]
  statusHistory             OrderStatusHistory[]
  checkoutAttempt           CheckoutAttempt?
  reservations              InventoryReservation[]
  discountUsage             DiscountUsage?
  walletHolds               WalletReservation[]
  reviews                   Review[]

  @@index([customerId, createdAt])
  @@index([status, createdAt])
  @@index([guestPhone])
  @@index([status, codConfirmationDeadlineAt])
  @@map("orders")
}

/// WhatsApp secure-link tokens (R10, R16; TASK-031). Only the hash is
/// stored; a link only confirms the order.
model CodConfirmationToken {
  id        String                @id @default(uuid(7)) @db.Uuid
  orderId   String                @map("order_id") @db.Uuid
  tokenHash String                @unique @map("token_hash")
  channel   CodConfirmationSource @default(WHATSAPP)
  /// Never later than the order's confirmation deadline.
  expiresAt DateTime              @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime?             @map("used_at") @db.Timestamptz(3)
  createdAt DateTime              @map("created_at") @db.Timestamptz(3)

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@map("cod_confirmation_tokens")
}

model OrderItem {
  id                  String   @id @default(uuid(7)) @db.Uuid
  orderId             String   @map("order_id") @db.Uuid
  productId           String   @map("product_id") @db.Uuid
  productVariantId    String   @map("product_variant_id") @db.Uuid
  skuSnapshot         String   @map("sku_snapshot")
  /// {"ar": …, "en": …}
  productNameSnapshot Json     @map("product_name_snapshot")
  variantNameSnapshot Json?    @map("variant_name_snapshot")
  /// Media asset id of the main image, if any.
  imageSnapshot       String?  @map("image_snapshot")
  unitPrice           BigInt   @map("unit_price")
  /// Weighted average cost at sale (Q103); null when the variant has none.
  unitCostAtSale      BigInt?  @map("unit_cost_at_sale")
  quantity            Int
  /// This line's share of the order discount.
  discountAmount      BigInt   @map("discount_amount")
  /// `unitPrice × quantity − discountAmount`.
  lineTotal           BigInt   @map("line_total")
  createdAt           DateTime @map("created_at") @db.Timestamptz(3)

  order   Order          @relation(fields: [orderId], references: [id], onDelete: Restrict)
  product Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Restrict)
  reviews Review[]

  @@unique([orderId, productVariantId])
  @@index([productVariantId])
  @@map("order_items")
}

model OrderStatusHistory {
  id            String         @id @default(uuid(7)) @db.Uuid
  orderId       String         @map("order_id") @db.Uuid
  /// Null for the order's first status.
  fromStatus    OrderStatus?   @map("from_status")
  toStatus      OrderStatus    @map("to_status")
  changedByType AuditActorType @map("changed_by_type")
  changedById   String?        @map("changed_by_id") @db.Uuid
  reason        String?
  createdAt     DateTime       @map("created_at") @db.Timestamptz(3)

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId, createdAt])
  @@map("order_status_history")
}

enum CheckoutAttemptStatus {
  STARTED
  SUCCEEDED
  FAILED

  @@map("checkout_attempt_status")
}

/// One successful checkout per Idempotency-Key and shopper (Q39). A failed
/// checkout rolls back with its transaction, so the key can be retried.
model CheckoutAttempt {
  id                 String                @id @default(uuid(7)) @db.Uuid
  /// "CUSTOMER:<id>" or "GUEST_CART:<token hash>".
  scope              String
  idempotencyKey     String                @map("idempotency_key")
  cartId             String                @map("cart_id") @db.Uuid
  resultOrderId      String?               @unique @map("result_order_id") @db.Uuid
  status             CheckoutAttemptStatus
  requestFingerprint String                @map("request_fingerprint")
  createdAt          DateTime              @map("created_at") @db.Timestamptz(3)
  completedAt        DateTime?             @map("completed_at") @db.Timestamptz(3)

  cart        Cart   @relation(fields: [cartId], references: [id], onDelete: Restrict)
  resultOrder Order? @relation(fields: [resultOrderId], references: [id], onDelete: Restrict)

  @@unique([scope, idempotencyKey])
  @@map("checkout_attempts")
}

// ---------------------------------------------------------------------------
// Reviews (DB design §16; TASK-044, ADR-0042). Verified purchase only: one
// review per delivered order and product (Q12, Q49), published immediately
// (Q11, Q173), hidden by moderation with its history kept (Q174).
// ---------------------------------------------------------------------------

enum ReviewStatus {
  PUBLISHED
  HIDDEN

  @@map("review_status")
}

/// One customer's review of a product, from one delivered order. Never
/// hard-deleted (trigger `reviews_no_delete`); hiding keeps it.
model Review {
  id               String       @id @default(uuid(7)) @db.Uuid
  customerId       String       @map("customer_id") @db.Uuid
  productId        String       @map("product_id") @db.Uuid
  orderId          String       @map("order_id") @db.Uuid
  /// The qualifying line; it names the purchased variant (C6).
  orderItemId      String       @map("order_item_id") @db.Uuid
  /// 1-5 (Q171; check constraint).
  rating           Int
  body             String
  status           ReviewStatus @default(PUBLISHED)
  /// The reason of the current hide; null while published.
  moderationReason String?      @map("moderation_reason")
  createdAt        DateTime     @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime     @map("updated_at") @db.Timestamptz(3)

  customer          Customer                @relation(fields: [customerId], references: [id], onDelete: Restrict)
  product           Product                 @relation(fields: [productId], references: [id], onDelete: Restrict)
  order             Order                   @relation(fields: [orderId], references: [id], onDelete: Restrict)
  orderItem         OrderItem               @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  moderationHistory ReviewModerationEvent[]
  reports           ReviewReport[]

  @@unique([orderId, productId])
  @@index([productId, status, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@index([customerId])
  @@map("reviews")
}

/// Hide/restore history (Q174). Append-only (trigger).
model ReviewModerationEvent {
  id         String       @id @default(uuid(7)) @db.Uuid
  reviewId   String       @map("review_id") @db.Uuid
  fromStatus ReviewStatus @map("from_status")
  toStatus   ReviewStatus @map("to_status")
  employeeId String       @map("employee_id") @db.Uuid
  reason     String?
  createdAt  DateTime     @map("created_at") @db.Timestamptz(3)

  review   Review   @relation(fields: [reviewId], references: [id], onDelete: Restrict)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@index([reviewId, createdAt])
  @@map("review_moderation_history")
}

/// A customer's report of a review, once per customer and review. Open until
/// the review is hidden.
model ReviewReport {
  id         String    @id @default(uuid(7)) @db.Uuid
  reviewId   String    @map("review_id") @db.Uuid
  customerId String    @map("customer_id") @db.Uuid
  reason     String?
  createdAt  DateTime  @map("created_at") @db.Timestamptz(3)
  resolvedAt DateTime? @map("resolved_at") @db.Timestamptz(3)

  review   Review   @relation(fields: [reviewId], references: [id], onDelete: Restrict)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@unique([reviewId, customerId])
  @@index([reviewId, resolvedAt])
  @@map("review_reports")
}
