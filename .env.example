# BeautyFits environment variables.
# Copy to `.env` for local development: `cp .env.example .env`
# Never commit real values. `.env*` files are gitignored (except this one).
# Every variable here is validated at runtime by src/server/config/env.ts.

# PostgreSQL connection string. The default matches docker-compose.yml
# (local development only; use a strong password anywhere else).
DATABASE_URL="postgresql://beautyfits:beautyfits@localhost:5432/beautyfits?schema=public"

# Log verbosity: debug | info | warn | error (default: info)
LOG_LEVEL="info"

# Reverse proxies / load balancers whose X-Forwarded-For and X-Real-IP headers
# are trusted, as comma-separated IPs or CIDR blocks (ADR-0013). Empty: the
# direct connection address is used and forwarding headers are ignored.
# Production behind a proxy MUST list it, e.g. "10.0.0.0/8".
TRUSTED_PROXIES=""

# Browser origins allowed to make cookie-authenticated state-changing requests
# (CSRF check, ADR-0013), comma-separated, e.g. "https://beautyfits.example".
# Empty: only the request's own origin. Set it in production.
AUTH_ALLOWED_ORIGINS=""

# Local mailbox (ADR-0014). Outgoing emails (verification and password reset
# codes) are written to this directory as .eml files instead of being sent;
# open them with any mail client or text editor. Default: .mail
MAIL_DIR=".mail"

# Local WhatsApp outbox (ADR-0043). Outgoing WhatsApp messages (order updates,
# COD confirmation links) are written to this directory as .json files until a
# WhatsApp provider is chosen. Default: .whatsapp
WHATSAPP_DIR=".whatsapp"

# Origin of the customer website (no path), used in links sent to customers,
# such as the COD confirmation link (ADR-0043). Default: http://localhost:3000
WEBSITE_URL="http://localhost:3000"

# Local file storage (ADR-0021). Uploaded files such as product images are
# stored in this directory until a storage provider is chosen. Keep it out of
# git and include it in backups. Default: .media
MEDIA_DIR=".media"

# Origin of the staff dashboard (no path), used in links sent to staff by
# email, such as employee invitations (ADR-0016). Default: http://localhost:3000
DASHBOARD_URL="http://localhost:3000"

# Bootstrap only (npm run db:seed, ADR-0017); never read by the web server.
# The first Owner account is created from these while no Owner exists. Set
# both or neither. Remove the password once the Owner exists; re-running the
# seed never changes an existing Owner. Password: at least 12 characters.
BOOTSTRAP_OWNER_EMAIL=""
BOOTSTRAP_OWNER_PASSWORD=""
# Optional display name (default: Owner).
BOOTSTRAP_OWNER_NAME=""

# Development seed only (npm run db:seed:dev): password of the sample staff
# accounts (at least 12 characters). Never used in production.
DEV_SEED_PASSWORD=""

# Integration tests only (npm run test:integration). A separate database whose
# name must end in _test; it is dropped and recreated on every test run.
TEST_DATABASE_URL="postgresql://beautyfits:beautyfits@localhost:5432/beautyfits_test?schema=public"
